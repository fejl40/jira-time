@* Narrow screens: a list of days instead of the grid. *@
@using System.Globalization

<ul class="divide-y divide-slate-100 overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-slate-200 sm:hidden dark:divide-slate-800 dark:bg-slate-900 dark:ring-slate-700" data-day-list>
    @foreach (var day in Sheet.Period.Days)
    {
        var info = Sheet.Day(day);
        var saved = Sheet.SavedOn(day);
        var logged = PeriodSheet.Total(saved);
        <li>
            <button type="button" class="motion-colors flex w-full items-center gap-3 px-4 py-2.5 text-left text-sm @(day == Selected ? "bg-blue-50 dark:bg-blue-950/60" : info is { IsWorkday: false } ? "bg-slate-50 dark:bg-slate-800/60" : "")"
                    @onclick="() => OnSelect.InvokeAsync(day)">
                <span class="w-20 flex-none @(day == Sheet.Today ? "font-semibold text-blue-700 dark:text-blue-400" : "")">@day.ToString("ddd d", CultureInfo.InvariantCulture)</span>
                <span class="flex-1 truncate text-xs text-slate-500 dark:text-slate-400">@Note(info)</span>
                @if (PeriodSheet.HasSyncProblem(saved))
                {
                    <span class="size-2 rounded-full bg-amber-500" title="Not in Jira"></span>
                }
                @if (Sheet.IsUnsaved(day))
                {
                    <span class="size-2 rounded-full bg-blue-600 dark:bg-blue-400" title="Unsaved changes"></span>
                }
                <span class="w-24 text-right tabular-nums">
                    @if (logged > TimeSpan.Zero || info is { Expected.Ticks: > 0 }) { <Count Value="logged" Zero="0" Unit=" h" /> }@if (info?.Expected is { } exp && exp > TimeSpan.Zero)
                    {
                        <span class="text-slate-400 dark:text-slate-500"> / @Format.Hours(exp)</span>
                    }
                </span>
                <span class="w-14 text-right text-xs tabular-nums text-amber-700 dark:text-amber-400">@(Sheet.Missing(day) is var m && m > TimeSpan.Zero ? $"−{Format.Hours(m)}" : "")</span>
            </button>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public PeriodSheet Sheet { get; set; } = default!;
    [Parameter] public DateOnly Selected { get; set; }
    [Parameter] public EventCallback<DateOnly> OnSelect { get; set; }

    private static string Note(DayInfo? info) => info switch
    {
        { IsWorkday: false } => info.Name ?? "Weekend",
        { HasPartialDayOff: true } => $"{info.Name} · {Format.Hours(info.Off)} h off",
        _ => "",
    };
}
