@* Narrow screens: a list of days instead of the grid. *@

<ul class="divide-y divide-slate-100 overflow-hidden panel sm:hidden dark:divide-slate-800" data-day-list>
    @foreach (var day in Sheet.Period.Days)
    {
        var info = Sheet.Info(day);
        var saved = Sheet.SavedOn(day);
        var logged = TimeEntry.Total(saved);
        <li>
            <button type="button" class="motion-colors flex w-full items-center gap-3 px-4 py-2.5 text-left text-sm @RowClass(day, info)"
                    @onclick="() => OnSelect.InvokeAsync(day)" data-day-off="@DayLook.Data(info)">
                <span class="w-16 flex-none @(day == Sheet.Today ? "font-semibold text-blue-700 dark:text-blue-400" : "")">@Format.WeekdayAndNumber(day)</span>
                @if (info?.Reason is { } reason)
                {
                    <span class="flex-1 truncate text-xs font-medium text-slate-700 dark:text-slate-200" title="@DayLook.Label(info)"><span aria-hidden="true">@DayLook.Icon(reason)</span> @DayLook.ShortLabel(info)</span>
                }
                else
                {
                    <span class="flex-1 truncate text-xs text-muted">@DayLook.KindName(info)</span>
                }
                @if (TimeEntry.HasSyncProblem(saved))
                {
                    <span class="dot-not-in-jira size-2" title="Not in Jira"></span>
                }
                @if (Sheet.IsUnsaved(day))
                {
                    <span class="dot-unsaved size-2" title="Unsaved changes"></span>
                }
                <span class="w-20 flex-none text-right tabular-nums">
                    @if (logged > TimeSpan.Zero || info is { Expected.Ticks: > 0 }) { <Count Value="logged" Zero="0" Unit=" h" /> }@if (info?.Expected is { } exp && exp > TimeSpan.Zero)
                    {
                        <span class="text-slate-400 dark:text-slate-500"> / @Format.Hours(exp)</span>
                    }
                </span>
                <span class="w-10 flex-none text-right text-xs tabular-nums text-warning">@(Sheet.Day(day).Missing is var m && m > TimeSpan.Zero ? $"−{Format.Hours(m)}" : "")</span>
            </button>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public PeriodSheet Sheet { get; set; } = default!;
    [Parameter] public DateOnly Selected { get; set; }
    [Parameter] public EventCallback<DateOnly> OnSelect { get; set; }

    /// <summary>Selected in blue, weekends and holidays grey, time off in its reason's tint.</summary>
    private string RowClass(DateOnly day, DayInfo? info)
    {
        var background = day == Selected ? "bg-blue-50 dark:bg-blue-950/60" : DayLook.Background(info);
        return $"{background} {DayLook.TimeOffClasses(info)}";
    }
}
