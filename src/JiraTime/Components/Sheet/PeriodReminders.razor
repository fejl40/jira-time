@* Reminders: Jira couldn't be read, the end of this period, and a previous period that isn't done. *@

@if (JiraError is not null)
{
    <div class="card flex flex-wrap items-center gap-3 border-amber-300 p-4 text-sm text-amber-800 dark:border-amber-700 dark:text-amber-300" role="alert" data-jira-error>
        <span class="flex-1">Couldn't read your time from Jira: @JiraError. Only work waiting to be sent is shown, and days can't be edited until Jira can be read.</span>
        <button type="button" class="btn-secondary" disabled="@(!Waits.CanStart)" @onclick="OnRetry">@if (Waits.Has(JiraWait.Period)) { <Waiting /> } Try again</button>
    </div>
}

@if (EndReminder is { } end)
{
    <div class="motion-pulse alert-warning" role="status" data-reminder="end">
        The period ends @(Sheet.Period.End == Sheet.Today ? "today" : Format.Day(Sheet.Period.End)): @end.
    </div>
}
@if (Previous is { } prev && !_previousHidden)
{
    <div class="motion-pulse flex flex-wrap items-center gap-3 alert-warning" role="status" data-reminder="previous">
        <span>Last period (@Format.Range(prev.Period.Start, prev.Period.End)) isn't done:
            @List(prev.Missing > TimeSpan.Zero ? $"{Format.Hours(prev.Missing)} h missing" : null,
                  prev.NotInJira > 0 ? $"{prev.NotInJira} not in Jira" : null).
        </span>
        <a class="btn-secondary ml-auto py-1" href="@Links.To(prev.Period)">Open it</a>
        <button class="btn-ghost px-1.5" title="Hide until the page is reloaded" aria-label="Hide" @onclick="() => _previousHidden = true">✕</button>
    </div>
}

@code {
    [Parameter, EditorRequired] public PeriodSheet Sheet { get; set; } = default!;
    /// <summary>The previous period, when this is the current one and the previous isn't done.</summary>
    [Parameter] public OpenPeriod? Previous { get; set; }
    /// <summary>Why Jira couldn't be read; the period then shows only work waiting for Jira.</summary>
    [Parameter] public string? JiraError { get; set; }
    [Parameter, EditorRequired] public JiraWaits Waits { get; set; } = default!;
    /// <summary>Reads Jira again.</summary>
    [Parameter] public EventCallback OnRetry { get; set; }

    private bool _previousHidden;

    /// <summary>What is left, in the last days of the current period; null when nothing is or it isn't ending.</summary>
    private string? EndReminder
    {
        get
        {
            if (!PeriodSummary.EndsSoon(Sheet.Period, Sheet.Today)) return null;
            var s = Sheet.Summary;
            var left = List(
                s.Missing > TimeSpan.Zero ? $"{Format.Hours(s.Missing)} h missing so far" : null,
                s.StillToLog > TimeSpan.Zero ? $"{Format.Hours(s.StillToLog)} h for the days left" : null,
                s.NotInJira > 0 ? $"{s.NotInJira} not in Jira" : null);
            return left == "" ? null : left;
        }
    }

    private static string List(params string?[] parts) => string.Join(", ", parts.Where(p => p is not null));
}
