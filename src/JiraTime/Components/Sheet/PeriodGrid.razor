@* Period grid: one row per issue, one column per day, with day, week, unsaved and missing totals. *@
@using System.Globalization

<div class="hidden overflow-x-auto rounded-xl bg-white dark:bg-slate-900 shadow-sm ring-1 ring-slate-200 dark:ring-slate-700 sm:block">
    <table class="w-full border-collapse text-sm">
        <thead>
            <tr class="border-b border-slate-200 dark:border-slate-700 text-xs text-slate-500 dark:text-slate-400">
                <th class="sticky left-0 z-10 min-w-64 bg-white dark:bg-slate-900 px-4 py-2 text-left font-medium">Issue</th>
                @foreach (var (day, i) in Days)
                {
                    <th class="@DayCellClass(day, i) min-w-12 p-0 font-medium" title="@DayTitle(day)">
                        <button type="button" class="relative w-full px-1 py-2" @onclick="() => OnSelectDay.InvokeAsync(day)">
                            <div class="uppercase">@day.ToString("ddd", CultureInfo.InvariantCulture)[..2]</div>
                            <div class="text-sm @(day == Sheet.Today ? "mx-auto grid size-6 place-items-center rounded-full bg-blue-600 font-semibold text-white" : "text-slate-700 dark:text-slate-200")">@day.Day</div>
                            @if (Sheet.IsUnsaved(day))
                            {
                                <span class="absolute right-1 top-1 size-1.5 rounded-full bg-blue-600 dark:bg-blue-400" title="Unsaved changes" data-unsaved-day></span>
                            }
                            @if (Sheet.Day(day) is { Expected.Ticks: > 0 })
                            {
                                var complete = Sheet.IsComplete(day);
                                <span class="mx-1.5 mt-1 block h-1 rounded-full bg-slate-200 dark:bg-slate-700 @(_complete.Fresh.Contains(day) ? "motion-pop" : "")" data-day-progress="@(complete ? "complete" : "")">
                                    <span class="motion-bar block h-full rounded-full @(complete ? "bg-emerald-500" : "bg-blue-500")" style="width: @Percent(Sheet.Progress(day))"></span>
                                </span>
                            }
                        </button>
                    </th>
                }
                <th class="min-w-16 px-3 py-2 text-right font-medium">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Rows)
            {
                <tr class="border-b border-slate-100 dark:border-slate-800 last:border-0 hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
                    <td class="sticky left-0 z-10 max-w-80 bg-white dark:bg-slate-900 px-4 py-2">
                        <div class="flex items-center gap-2">
                            <span class="size-2.5 flex-none rounded-full @IssueColors.For(row.Key)"></span>
                            @if (row.Key == "")
                            {
                                <span class="italic text-slate-500 dark:text-slate-400">No issue chosen yet</span>
                            }
                            else
                            {
                                <a href="@($"{JiraBaseUrl}/browse/{row.Key}")" target="_blank" rel="noopener"
                                   class="font-semibold text-blue-700 dark:text-blue-400 hover:underline">@row.Key</a>
                            }
                            <span class="truncate text-slate-600 dark:text-slate-300" title="@row.Summary">@row.Summary</span>
                        </div>
                    </td>
                    @foreach (var (day, i) in Days)
                    {
                        var cellEntries = row.Entries.Where(e => e.Date == day).ToList();
                        var saved = PeriodSheet.Total(cellEntries);
                        <td class="@DayCellClass(day, i) relative cursor-pointer p-2 text-center tabular-nums" @onclick="() => OnCellClicked.InvokeAsync((day, row))" title="@CellTitle(day, row, cellEntries)">
                            @if (PeriodSheet.HasSyncProblem(cellEntries))
                            {
                                <span class="absolute right-1 top-1 size-1.5 rounded-full bg-amber-500" data-not-in-jira></span>
                            }
                            @if (Sheet.UnsavedFor(day, row.Key) is { } unsaved)
                            {
                                @if (saved > TimeSpan.Zero)
                                {
                                    <span class="text-slate-400 line-through dark:text-slate-500">@Format.Hours(saved)</span>
                                }
                                <span class="motion-drop ml-0.5 inline-block rounded border border-dashed border-blue-400 px-1 text-xs text-blue-700 dark:border-blue-600 dark:text-blue-300" title="Not saved yet"
                                      style="@(Cascade ? Motion.Order(i) : null)" data-draft-cell>@(unsaved > TimeSpan.Zero ? Format.Hours(unsaved) : "0")</span>
                            }
                            else if (saved > TimeSpan.Zero)
                            {
                                var justSaved = JustSaved.Contains(day);
                                <span class="inline-block rounded px-1 @(justSaved ? "motion-settle" : "")" data-sent="@(justSaved && SentToJira.Contains(day) ? "" : null)">@Format.Hours(saved)</span>
                            }
                        </td>
                    }
                    <td class="px-3 py-2 text-right font-medium tabular-nums"><Count Value="PeriodSheet.Total(row.Entries)" /></td>
                </tr>
            }
            @if (Rows.Count == 0)
            {
                <tr>
                    <td colspan="@(Sheet.Period.Length + 2)" class="px-4 py-10 text-center text-slate-500 dark:text-slate-400">No time logged in this period yet. Pick a day below and add an entry.</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="border-t border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 text-xs font-semibold">
                <td class="@FooterLabel text-slate-500 dark:text-slate-400">Day total</td>
                @foreach (var (day, i) in Days)
                {
                    <td class="@DayCellClass(day, i, footer: true) p-2 text-center tabular-nums"><Count Value="PeriodSheet.Total(Sheet.SavedOn(day))" /></td>
                }
                <td class="px-3 py-2 text-right tabular-nums"><Count Value="PeriodSheet.Total(Sheet.Entries)" /></td>
            </tr>
            <tr class="bg-slate-50 dark:bg-slate-800/60 text-xs" data-week-totals>
                <td class="@FooterLabel font-semibold text-slate-500 dark:text-slate-400">Week</td>
                @foreach (var week in Sheet.Summary.Weeks)
                {
                    <td colspan="@week.Days" class="@(week.Start == Sheet.Period.Start ? "" : "border-l-2 border-slate-300 dark:border-slate-600") px-2 py-2 text-center tabular-nums @(week.Expected > TimeSpan.Zero && week.Logged >= week.Expected ? "text-emerald-700 dark:text-emerald-400" : "text-slate-600 dark:text-slate-300")"
                        title="Logged in the week (within this period) / hours the week needs">
                        <Count Value="week.Logged" Zero="0" Unit=" h" Class="font-semibold" />@if (week.Expected > TimeSpan.Zero)
                        {
                            <span class="text-slate-400 dark:text-slate-500"> / @Format.Hours(week.Expected) h</span>
                        }
                    </td>
                }
                <td></td>
            </tr>
            @if (Sheet.UnsavedDays.Count > 0)
            {
                <tr class="bg-slate-50 dark:bg-slate-800/60 text-xs font-semibold text-blue-700 dark:text-blue-300">
                    <td class="@FooterLabel" title="Day totals once the unsaved changes are saved">Unsaved</td>
                    @foreach (var (day, i) in Days)
                    {
                        <td class="@DayCellClass(day, i, footer: true) p-2 text-center tabular-nums">@if (Sheet.IsUnsaved(day)) { <Count Value="Sheet.UnsavedDayTotal(day)" Zero="0" /> }</td>
                    }
                    <td class="px-3 py-2 text-right tabular-nums"><Count Value="Sheet.UnsavedTotal" /></td>
                </tr>
            }
            @if (Sheet.Summary.Missing > TimeSpan.Zero)
            {
                <tr class="bg-slate-50 dark:bg-slate-800/60 text-xs font-semibold text-amber-700 dark:text-amber-400">
                    <td class="@FooterLabel">Missing</td>
                    @foreach (var (day, i) in Days)
                    {
                        <td class="@DayCellClass(day, i, footer: true) p-2 text-center tabular-nums"><Count Value="Sheet.Missing(day)" /></td>
                    }
                    <td class="px-3 py-2 text-right tabular-nums"><Count Value="Sheet.Summary.Missing" /></td>
                </tr>
            }
        </tfoot>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public PeriodSheet Sheet { get; set; } = default!;
    [Parameter] public DateOnly Selected { get; set; }
    /// <summary>Links on issue keys go here.</summary>
    [Parameter] public string? JiraBaseUrl { get; set; }
    /// <summary>Days saved by the last Save day or Save all; their cells settle from draft to saved.</summary>
    [Parameter] public IReadOnlySet<DateOnly> JustSaved { get; set; } = new HashSet<DateOnly>();
    /// <summary>Days of <see cref="JustSaved"/> that Jira got completely; a tick flies from their cells.</summary>
    [Parameter] public IReadOnlySet<DateOnly> SentToJira { get; set; } = new HashSet<DateOnly>();
    /// <summary>New suggestion cells drop in one day after another (right after Fill period).</summary>
    [Parameter] public bool Cascade { get; set; }
    [Parameter] public EventCallback<DateOnly> OnSelectDay { get; set; }
    [Parameter] public EventCallback<(DateOnly Day, PeriodRow Row)> OnCellClicked { get; set; }

    private const string FooterLabel = "sticky left-0 z-10 bg-slate-50 dark:bg-slate-800 px-4 py-2";

    private IReadOnlyList<PeriodRow> Rows = [];

    /// <summary>Days that became complete while this period is shown; they pop once.</summary>
    private Milestones<DateOnly> _complete = new();
    private PeriodSheet? _shown;

    protected override void OnParametersSet()
    {
        Rows = Sheet.Rows;
        if (_shown != Sheet) (_shown, _complete) = (Sheet, new());
        _complete.Update(Sheet.Period.Days.Where(Sheet.IsComplete));
    }

    private static string Percent(double share) => (share * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private IEnumerable<(DateOnly Day, int Index)> Days => Sheet.Period.Days.Select((d, i) => (d, i));

    private string? DayTitle(DateOnly day) => Sheet.Day(day) switch
    {
        { Kind: DayKind.Holiday, Name: var n } => n,
        { Kind: DayKind.DayOff, Name: var n } => $"Day off ({n})",
        { HasPartialDayOff: true } d => $"{d.Name}: {Format.Hours(d.Off)} h off",
        _ => null,
    };

    private static string CellTitle(DateOnly day, PeriodRow row, IReadOnlyList<TimeEntry> entries)
    {
        if (row.Key == "") return "";
        var title = $"{row.Key} on {day.ToString("ddd d MMM", CultureInfo.InvariantCulture)}";
        var problems = entries.Where(e => !e.IsSynced).Select(e => e.SyncError ?? "Not sent to Jira yet").Distinct().ToList();
        return problems.Count == 0 ? title : $"{title}\nNot in Jira: {string.Join("; ", problems)}";
    }

    private string DayCellClass(DateOnly day, int index, bool footer = false)
    {
        var info = Sheet.Day(day);
        var classes = new List<string>();
        if (index > 0 && day.DayOfWeek == DayOfWeek.Monday) classes.Add("border-l-2 border-slate-300 dark:border-slate-600"); // week boundary
        if (day == Selected) classes.Add("bg-blue-50 dark:bg-blue-950/60");
        else if (!footer && info is { IsWorkday: false }) classes.Add("bg-slate-50 dark:bg-slate-800/60");
        if (!footer && info is { Kind: DayKind.Holiday or DayKind.DayOff }) classes.Add("text-slate-400 dark:text-slate-500");
        return string.Join(' ', classes);
    }
}
