@* The selected day's title, hours, kind of day and time off (asked for in TimeOffModal). *@
@inject Modals Modals

<div class="flex flex-wrap items-center gap-3">
    <h2 class="text-lg font-semibold">@Format.LongDay(Date)</h2>
    @if (Logged > TimeSpan.Zero)
    {
        <Count Value="Logged" Unit=" h" Class="text-sm text-muted" />
    }
    else
    {
        <span class="text-sm text-muted">Nothing logged</span>
    }
    @if (DayLook.KindName(Info) is { } kindName)
    {
        <span class="@Badge">@kindName</span>
    }
    @if (Info is { Kind: DayKind.Workday } && Missing > TimeSpan.Zero)
    {
        <span class="text-sm text-warning"><Count Value="Missing" Unit=" h" /> missing</span>
    }
    @if (Info is { Reason: { } reason } && DayLook.Label(Info) is { } timeOff)
    {
        <span class="@DayLook.Badge(reason)" data-time-off>@Icon @timeOff</span>
        <button class="btn-ghost text-xs" disabled="@Busy" @onclick="OnUnmarkOff" data-time-off-undo>@if (Saving) { <Waiting /> } Undo</button>
    }
    else if (Info is { Kind: DayKind.Workday } work)
    {
        <button class="btn-ghost text-xs" disabled="@Busy" @onclick="() => OpenTimeOffAsync(work)" data-time-off-open>@if (Saving) { <Waiting /> } Time off…</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public DateOnly Date { get; set; }
    [Parameter] public DayInfo? Info { get; set; }
    [Parameter] public TimeSpan Logged { get; set; }
    /// <summary>Hours missing so far (zero after today).</summary>
    [Parameter] public TimeSpan Missing { get; set; }
    /// <summary>A wait on Jira is running (time off is one): the time off buttons are off meanwhile.</summary>
    [Parameter] public bool Busy { get; set; }
    /// <summary>Time off is being marked or removed: its button shows the spinner.</summary>
    [Parameter] public bool Saving { get; set; }
    [Parameter] public EventCallback<TimeOffModal.TimeOff> OnMarkOff { get; set; }
    [Parameter] public EventCallback OnUnmarkOff { get; set; }

    /// <summary>The reason's icon; the sun of a vacation rises in.</summary>
    private RenderFragment? Icon => Info?.Reason is { } reason
        ? @<span class="@(reason == DayOffReason.Vacation ? "motion-sunrise" : "motion-fade") inline-block" aria-hidden="true">@DayLook.Icon(reason)</span>
        : null;

    private const string Badge = "rounded-full bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 text-xs text-slate-600 dark:text-slate-300";

    private Task OpenTimeOffAsync(DayInfo work) =>
        Modals.ShowAsync<TimeOffModal, TimeOffModal.TimeOff>(new Dictionary<string, object?>
        {
            [nameof(TimeOffModal.Day)] = work,
            [nameof(TimeOffModal.Save)] = (Func<TimeOffModal.TimeOff, Task>)(off => OnMarkOff.InvokeAsync(off)),
        });
}
