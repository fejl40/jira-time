@* One row of the day editor: issue, hours and comment to edit, or a removed row to undo, with its state
   and notes (errors, Jira's reason, an issue that is Done). Edits go to the day's DayWork. *@
@inject MotionScript Animations

<li class="motion-colors flex flex-wrap items-center gap-2 py-2.5 @RowClass" data-row="@(Row.Removed ? "removed" : Row.IsDraft ? "draft" : "saved")" data-row-id="@E.Id">
    @* Keyed by issue, so picking an issue makes a new dot that can pop. *@
    <span @key="E.IssueKey" class="size-2.5 flex-none rounded-full @(E.IssueKey == "" ? "bg-slate-300" : IssueColors.For(E.IssueKey)) @(Picked ? "motion-grow" : "")"></span>
    @if (Row.Removed)
    {
        <div class="min-w-56 flex-1 basis-64 truncate text-sm text-slate-500 line-through dark:text-slate-400">
            <span class="font-semibold">@E.IssueKey</span> @E.IssueSummary
        </div>
        <span class="w-20 text-right text-sm tabular-nums text-slate-500 line-through dark:text-slate-400">@Format.Hours(E.Duration) h</span>
        <span class="min-w-40 flex-1 basis-48 truncate text-sm text-slate-500 line-through dark:text-slate-400">@E.Description</span>
        <span class="w-48 text-right text-xs font-medium text-red-700 dark:text-red-400">@(E.JiraWorklogId is null ? "Removed" : "Deletes the worklog in Jira")</span>
        <button type="button" class="btn-ghost text-xs" title="Keep this row" @onclick="Restore">Undo</button>
    }
    else
    {
        <div class="min-w-56 flex-1 basis-64">
            <IssuePicker Id="@($"issue-{E.Id}")" Value="new JiraIssue(E.IssueKey, E.IssueSummary)" Choices="Choices" Search="Search" OnSelected="PickIssue" />
        </div>
        <div class="flex items-center gap-1">
            <input type="text" inputmode="decimal" class="field w-20 py-1.5 text-right" aria-label="Hours" placeholder="h"
                   id="hours-@E.Id" data-hours value="@HoursText" @onchange="SetHours" />
            <span class="text-sm text-slate-500 dark:text-slate-400">h</span>
        </div>
        <input type="text" class="field min-w-40 flex-1 basis-48 py-1.5" aria-label="Comment" placeholder="Comment (optional)"
               list="@CommentListId(E.IssueKey)" data-comment value="@E.Description" @onchange="SetDescription" />
        <span class="w-32 text-right text-xs" title="@E.SyncError">
            @switch (Row.State)
            {
                case RowState.New or RowState.Suggested or RowState.Changed:
                    <span class="font-medium text-blue-700 dark:text-blue-300">@Row.State</span>
                    break;
                case RowState.InJira:
                    <span class="text-emerald-700 dark:text-emerald-400">✓ In Jira</span>
                    break;
                default:
                    <span class="font-medium text-amber-700 dark:text-amber-400">Not in Jira</span>
                    break;
            }
        </span>
        <button type="button" class="btn-ghost" title="Remove" aria-label="Remove" @onclick="Remove">✕</button>
    }
    @if (Errors.GetValueOrDefault(E.Id) is { } error)
    {
        <span class="basis-full pl-5 text-xs text-red-700 dark:text-red-400" role="alert">@error</span>
    }
    else if (Row.ShowsSyncError)
    {
        <span class="basis-full pl-5 text-xs text-amber-700 dark:text-amber-400">Jira: @E.SyncError</span>
    }
    @if (!Row.Removed && Choices.Statuses.GetValueOrDefault(E.IssueKey) is { IsDone: true } done)
    {
        <span class="basis-full pl-5 text-xs text-amber-700 dark:text-amber-400" data-not-todo>
            @E.IssueKey is @done.Status in Jira, so this time is logged on an issue that isn't to do any more.
        </span>
    }
</li>

@code {
    [Parameter, EditorRequired] public WorkRow Row { get; set; } = default!;
    /// <summary>The day's unsaved changes, which the row's edits go to.</summary>
    [Parameter, EditorRequired] public DayWork Work { get; set; } = default!;
    /// <summary>What the issue picker offers; its statuses also mark rows on Done issues.</summary>
    [Parameter, EditorRequired] public IssueChoices Choices { get; set; } = default!;
    [Parameter, EditorRequired] public Func<string, CancellationToken, Task<IReadOnlyList<JiraIssue>>> Search { get; set; } = default!;
    /// <summary>The day editor's errors by row id: why a row can't be saved. Editing the row clears its error.</summary>
    [Parameter, EditorRequired] public Dictionary<string, string> Errors { get; set; } = default!;
    /// <summary>The row's issue was just picked: its dot pops.</summary>
    [Parameter] public bool Picked { get; set; }
    /// <summary>Raised after the row's issue was picked (and the change made).</summary>
    [Parameter] public EventCallback<JiraIssue> OnPicked { get; set; }
    /// <summary>Raised after any other change to the row.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private TimeEntry E => Row.Entry;

    /// <summary>The hours as typed (kept when they can't be read) or as saved.</summary>
    private string HoursText => Work.BadHours.TryGetValue(E.Id, out var text) ? text : Format.Hours(E.Duration);

    private Task PickIssue(JiraIssue issue)
    {
        Errors.Remove(Work.PickIssue(E, Row.Saved, issue).Id);
        return OnPicked.InvokeAsync(issue);
    }

    private Task SetHours(ChangeEventArgs ev)
    {
        Work.SetHours(E, Row.Saved, ev.Value?.ToString());
        Errors.Remove(E.Id);
        return OnChanged.InvokeAsync();
    }

    private Task SetDescription(ChangeEventArgs ev)
    {
        Work.SetDescription(E, Row.Saved, ev.Value?.ToString());
        return OnChanged.InvokeAsync();
    }

    /// <summary>A saved row is marked removed (it turns red); a new row collapses and goes.</summary>
    private async Task Remove()
    {
        if (Row.IsDraft) await Animations.CollapseAsync($"[data-row-id='{E.Id}']");
        Work.Remove(E, Row.Saved);
        Errors.Remove(E.Id);
        await OnChanged.InvokeAsync();
    }

    private Task Restore()
    {
        Work.Restore(Row.Saved!);
        return OnChanged.InvokeAsync();
    }

    private string RowClass => Row.State switch
    {
        RowState.Removed => "-mx-2 rounded-md bg-red-50/60 px-2 dark:bg-red-950/20",
        RowState.New or RowState.Suggested => "-mx-2 rounded-md bg-blue-50/60 px-2 dark:bg-blue-950/30",
        _ => "",
    };

    /// <summary>The id of the issue's list of recent comments (a datalist in the day editor).</summary>
    public static string CommentListId(string issueKey) =>
        issueKey == "" ? "" : "comments-" + string.Concat(issueKey.Where(char.IsLetterOrDigit));
}
