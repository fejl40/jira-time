@* Period header: navigation and title, one status line, the main action, and the Save all question.
   Confetti when the period shown becomes complete. *@
@inject MotionScript Animations
@inject CurrentUser User

<div class="flex flex-wrap items-center gap-x-4 gap-y-3">
    <StepNav Unit="period" PreviousHref="@Links.To(Period.Previous)" NextHref="@Links.To(Period.Next)" CurrentLabel="Today" CurrentTitle="Go to today" />
    <div>
        <h1 @key="Period" class="motion-fade text-xl font-semibold leading-tight outline-none">@Format.Range(Period.Start, Period.End)</h1>
        <p class="text-sm text-muted" data-period-status>
            <span><Count Value="Summary.Logged" Zero="0" Unit=" h" Class="font-semibold text-slate-800 dark:text-slate-100" /> logged</span>
            @if (Sheet.HoursKnown && Summary.IsComplete(Unsynced, Unsaved.Count > 0))
            {
                <span class="ml-2 rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300" data-period-complete
                      title="No workday up to today is short, nothing is unsaved and everything is in Jira">✓ Complete so far</span>
            }
            @if (Sheet.HoursKnown && Summary.Missing > TimeSpan.Zero)
            {
                <span> · <span class="text-warning" title="Hours missing on workdays up to today"><Count Value="Summary.Missing" Unit=" h" /> missing</span></span>
            }
            @if (Unsaved.Count > 0)
            {
                <span> · <span class="text-unsaved">unsaved on @Format.Days(Unsaved.Count)</span></span>
            }
            @if (Unsynced > 0)
            {
                <span> · <span class="text-warning" title="Saved here, but Jira doesn't have it yet">@Unsynced not in Jira</span></span>
            }
            <button class="btn-ghost ml-1 px-1.5 py-0.5 text-xs" disabled="@(!Waits.CanStart)" @onclick="OnSync" data-sync
                    title="Send what Jira is missing and read worklogs logged in Jira">@if (Waits.Has(JiraWait.Sync)) { <Waiting /> <span>Sync</span> } else { @(Unsynced > 0 ? "Sync now" : "↻ Sync") }</button>
            <a class="btn-ghost px-1.5 py-0.5 text-xs" href="@ExportLinks.To(Period.Start)" title="Export the month this period is in" data-export-link>Export month</a>
            @if (Waits.Status(Period) is { } waiting)
            {
                <Waiting Label="@waiting" Class="ml-1 text-xs text-blue-700 dark:text-blue-300" data-period-waiting />
            }
        </p>
    </div>
    <div class="ml-auto flex items-center gap-2">
        @if (Unsaved.Count > 0)
        {
            <button class="btn-ghost" disabled="@(!Waits.CanStart)" @onclick="DiscardAllAsync">Discard all</button>
            <button class="btn-primary" disabled="@(!Waits.CanStart)" @onclick="() => _confirming = true" data-save-all>@if (Waits.Has(JiraWait.SaveAll)) { <Waiting /> } Save all (@Format.Days(Unsaved.Count))</button>
        }
        else if (CanFillAny)
        {
            <button class="btn-primary" title="@FillTitle" disabled="@(!Waits.CanStart)" @onclick="OnFillPeriod">Fill period</button>
        }
        @if (Unsaved.Count > 0 && CanFillMore)
        {
            <button class="btn-secondary order-first" title="@FillTitle" disabled="@(!Waits.CanStart)" @onclick="OnFillPeriod">Fill period</button>
        }
    </div>
</div>

@if (_confirming && Unsaved.Count > 0)
{
    <div class="flex flex-wrap items-center gap-3 rounded-lg bg-blue-50 px-4 py-3 text-sm ring-1 ring-blue-200 dark:bg-blue-950/40 dark:ring-blue-900" role="alertdialog" data-confirm-save-all>
        <span>Save @Format.Days(Unsaved.Count) (@Format.HoursText(Sheet.UnsavedTotal)) and update Jira to match?
            @if (Sheet.UnsavedRemovals is var removals and > 0)
            {
                <span class="text-red-700 dark:text-red-400">@removals @(removals == 1 ? "worklog is" : "worklogs are") deleted.</span>
            }
        </span>
        <button class="btn-secondary ml-auto" @onclick="() => _confirming = false">Cancel</button>
        <button class="btn-primary" disabled="@(!Waits.CanStart)" @onclick="SaveAllAsync">Save @Format.Days(Unsaved.Count)</button>
    </div>
}

@code {
    [Parameter, EditorRequired] public PeriodSheet Sheet { get; set; } = default!;
    /// <summary>Saved entries in the period that Jira doesn't have yet.</summary>
    [Parameter] public int Unsynced { get; set; }
    /// <summary>Requests to Jira that are running: the status line says so and the buttons wait.</summary>
    [Parameter, EditorRequired] public JiraWaits Waits { get; set; } = default!;
    [Parameter] public EventCallback OnSync { get; set; }
    [Parameter] public EventCallback OnFillPeriod { get; set; }
    [Parameter] public EventCallback OnSaveAll { get; set; }
    [Parameter] public EventCallback OnDiscardAll { get; set; }

    private const string FillTitle = "Suggest work for every workday so far that is short of hours";

    private bool _confirming;
    private Period? _shown;
    /// <summary>Notices the period becoming complete while it is shown (not one that already was).</summary>
    private Milestones<Period> _completed = new();

    private Period Period => Sheet.Period;
    private PeriodSummary Summary => Sheet.Summary;
    private IReadOnlyList<DateOnly> Unsaved => Sheet.UnsavedDays;
    private bool CanFillAny => Period.Days.Any(Sheet.CanFill);
    private bool CanFillMore => Period.Days.Any(d => Sheet.CanFill(d) && !Sheet.IsUnsaved(d));

    protected override void OnParametersSet()
    {
        // A new period starts without the Save all question, and is complete or not at first look.
        if (_shown == Period) return;
        _shown = Period;
        _confirming = false;
        _completed = new();
    }

    /// <summary>Confetti when the period becomes complete; the script makes sure each period celebrates once per browser.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (User.Key is not { } user) return;
        var complete = Summary.IsComplete(Unsynced, Unsaved.Count > 0);
        if (_completed.Update(complete ? [Period] : []).Count > 0)
            await Animations.CelebrateAsync(user, Period);
    }

    private Task SaveAllAsync()
    {
        _confirming = false;
        return OnSaveAll.InvokeAsync();
    }

    private Task DiscardAllAsync()
    {
        _confirming = false;
        return OnDiscardAll.InvokeAsync();
    }
}
