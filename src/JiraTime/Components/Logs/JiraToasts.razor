@implements IDisposable
@inject CurrentUser User
@inject JiraRequestFeed Feed
@inject TimeProvider Clock
@inject NavigationManager Nav

@* Each Jira request of the signed-in user as a toast in the bottom left, pushed live over the circuit.
   Newest at the bottom; the rules (how long, how many) are in Domain/RequestToasts. On phones only the
   two newest show, narrow, and the page has room below the day editor so they never sit on Save day. *@

@if (_toasts.Any)
{
    <div class="fixed bottom-3 left-3 z-40 flex w-[min(60vw,16rem)] flex-col gap-1.5 sm:w-80"
         @onmouseenter="Pause" @onmouseleave="Resume" @onfocusin="Pause" @onfocusout="Resume" data-toasts>
        @if (_toasts.Hidden > 0)
        {
            <a href="@LogLinks.To(Today)" class="self-start rounded-full bg-slate-800/90 px-3 py-1 text-xs text-white shadow ring-1 ring-white/10 hover:bg-slate-700 dark:bg-slate-700/90"
               data-toasts-more>+@_toasts.Hidden more</a>
        }
        @foreach (var (toast, i) in _toasts.Shown.Select((t, i) => (t, i)))
        {
            var entry = toast.Entry;
            <div @key="entry.Id" role="status"
                 class="motion-rise flex items-start gap-1 rounded-lg bg-white text-xs shadow-lg ring-1 transition-opacity duration-(--motion) dark:bg-slate-800 @Ring(entry) @(toast.Leaving ? "opacity-0" : "") @(i < _toasts.Shown.Count - 2 ? "max-sm:hidden" : "")"
                 data-toast="@entry.Id" data-toast-state="@State(entry)">
                <button type="button" class="flex min-w-0 flex-1 items-start gap-2 px-3 py-1.5 text-left" @onclick="() => Open(entry)"
                        title="Open in Logs: @entry.Method @entry.Path">
                    <span class="mt-0.5 flex-none" aria-hidden="true">
                        @if (entry.IsPending)
                        {
                            <span class="block size-3 animate-spin rounded-full border-2 border-slate-300 border-t-blue-600 dark:border-slate-600 dark:border-t-blue-400"></span>
                        }
                        else
                        {
                            <span class="block size-3 rounded-full @(entry.Failed ? "bg-red-500" : "bg-emerald-500")"></span>
                        }
                    </span>
                    <span class="min-w-0 flex-1">
                        <span class="block truncate font-medium text-slate-800 dark:text-slate-100">@entry.Action</span>
                        <span class="block truncate text-[11px] text-muted"><span class="font-mono">@entry.Method @ShortPath(entry)</span> · <span class="@(entry.Failed ? "text-red-700 dark:text-red-400" : "")">@Outcome(entry)</span></span>
                    </span>
                </button>
                @if (entry.Failed)
                {
                    <button type="button" class="btn-ghost m-1 px-1.5 py-0.5" aria-label="Close" @onclick="() => _toasts.Close(entry.Id)" data-toast-close>✕</button>
                }
            </div>
        }
    </div>
}

@code {
    private static readonly TimeSpan TickEvery = TimeSpan.FromMilliseconds(250);

    private RequestToasts _toasts = default!;
    private IDisposable? _subscription;
    private ITimer? _timer;

    private DateOnly Today => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);

    protected override void OnInitialized()
    {
        _toasts = new RequestToasts(Clock);
        _timer = Clock.CreateTimer(_ => InvokeAsync(Tick), null, Timeout.InfiniteTimeSpan, Timeout.InfiniteTimeSpan);
        User.Changed += Subscribe;
        Subscribe();
    }

    /// <summary>Listens to the signed-in user's requests only; signing out or in switches the feed.</summary>
    private void Subscribe()
    {
        _subscription?.Dispose();
        _subscription = User.Key is { } key ? Feed.Subscribe(key.Id, Show) : null;
    }

    private Task Show(JiraRequestEvent e) => InvokeAsync(() =>
    {
        _toasts.Update(e.Entry);
        _timer?.Change(TickEvery, TickEvery);
        StateHasChanged();
    });

    private void Tick()
    {
        if (_toasts.Tick()) StateHasChanged();
        if (!_toasts.Any) _timer?.Change(Timeout.InfiniteTimeSpan, Timeout.InfiniteTimeSpan);
    }

    private void Pause() => _toasts.Pause();

    private void Resume() => _toasts.Resume();

    private void Open(JiraLogEntry entry) => Nav.NavigateTo(LogLinks.To(entry));

    private static string State(JiraLogEntry e) => e.IsPending ? "pending" : e.Failed ? "error" : "ok";

    private static string Ring(JiraLogEntry e) => e.IsPending || !e.Failed
        ? "ring-slate-200 dark:ring-slate-700"
        : "ring-red-300 dark:ring-red-800";

    /// <summary>The path without the REST prefix and query: "issue/ABC-1/worklog".</summary>
    private static string ShortPath(JiraLogEntry e)
    {
        var path = e.Path.Split('?')[0];
        foreach (var prefix in new[] { "/rest/api/3/", "/rest/api/2/" })
            if (path.Contains(prefix)) return path[(path.IndexOf(prefix) + prefix.Length)..];
        return path;
    }

    private static string Outcome(JiraLogEntry e) => e switch
    {
        { IsPending: true } => "Waiting for Jira…",
        { Status: { } status, Error: null } => $"{status} · {Format.Duration(e.DurationMs ?? 0)}",
        { Status: { } status } => $"{status} {e.Error} · {Format.Duration(e.DurationMs ?? 0)}",
        _ => $"{e.Error} · {Format.Duration(e.DurationMs ?? 0)}",
    };

    public void Dispose()
    {
        User.Changed -= Subscribe;
        _subscription?.Dispose();
        _timer?.Dispose();
    }
}
