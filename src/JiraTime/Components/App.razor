<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* Sets the theme before the page paints, so there is no flash of the wrong one. *@
    <script src="@Assets["theme.js"]"></script>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["JiraTime.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="Mode" />
</head>

<body>
    <Routes @rendermode="Mode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["keys.js"]"></script>
    <script src="@Assets["motion.js"]"></script>
    <script src="@Assets["export.js"]"></script>
</body>

</html>

@code {
    // No prerendering: the app reads the (encrypted) connection from localStorage,
    // which is only reachable once the interactive circuit is up.
    private static readonly IComponentRenderMode Mode = new InteractiveServerRenderMode(prerender: false);
}
