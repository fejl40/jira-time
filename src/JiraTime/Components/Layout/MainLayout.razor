@inherits LayoutComponentBase
@implements IDisposable
@inject CurrentUser User
@inject SignInSession Session
@inject NavigationManager Nav
@using JiraTime.Components.Logs

<div class="flex min-h-full flex-col">
    <header class="flex h-14 flex-none items-center gap-3 bg-slate-800 px-3 text-white sm:gap-6 sm:px-5 dark:bg-slate-950">
        <a href="" class="flex-none font-semibold tracking-tight">Jira Time</a>

        @if (User.IsSignedIn)
        {
            @* On phones the links scroll sideways instead of widening the page. *@
            <nav class="flex min-w-0 gap-1 overflow-x-auto whitespace-nowrap text-sm">
                <a href="" class="rounded-md px-3 py-1.5 hover:bg-white/10 hover:text-white @(OnTimesheet ? "bg-white/15 text-white" : "text-slate-300")">Timesheet</a>
                <NavLink href="export" class="rounded-md px-3 py-1.5 text-slate-300 hover:bg-white/10 hover:text-white" ActiveClass="!bg-white/15 !text-white">Export</NavLink>
                <NavLink href="logs" class="rounded-md px-3 py-1.5 text-slate-300 hover:bg-white/10 hover:text-white" ActiveClass="!bg-white/15 !text-white" data-nav-logs>Logs</NavLink>
                <NavLink href="settings" class="rounded-md px-3 py-1.5 text-slate-300 hover:bg-white/10 hover:text-white" ActiveClass="!bg-white/15 !text-white">Settings</NavLink>
            </nav>
        }

        <div class="ml-auto flex flex-none items-center gap-3 text-sm">
            <ThemeToggle />
            @if (User.Jira is { Connection: var c, Profile: var p })
            {
                @if (User.VerifiedOffline)
                {
                    <span class="rounded-full bg-amber-500/20 px-2 py-0.5 text-xs text-amber-200" title="Jira can't be reached right now. You are signed in with a token Jira confirmed before; changes are sent to Jira when it is back (Sync now).">Offline</span>
                }
                <span class="hidden text-slate-400 sm:inline">@c.Host</span>
                <span class="avatar bg-slate-600 text-white">@p.Initials</span>
                <span class="hidden sm:inline">@p.DisplayName</span>
            }
        </div>
    </header>

    @* On phones the extra room at the bottom lets the day editor scroll clear of the request toasts. *@
    <main class="flex-1 px-4 pb-28 pt-8 sm:px-6 sm:pb-8">
        @if (_verifyError is not null && !OnSetup)
        {
            <ErrorCard Class="mx-auto max-w-lg" Title="Can't check who you are" Error="@_verifyError">
                <ChildContent>Jira Time asks your Jira who your token belongs to before showing your hours, and that didn't work:</ChildContent>
                <Actions>
                    <a href="setup/connect" class="btn-secondary">Connect again</a>
                    <button class="btn-primary" disabled="@_verifying" @onclick="VerifyAsync">@if (_verifying) { <Waiting /> } Try again</button>
                </Actions>
            </ErrorCard>
        }
        else if (_ready)
        {
            @Body
        }
        else if (_verifying)
        {
            <Waiting Block Label="Checking your Jira connection…" Class="py-10 text-sm text-muted" data-signing-in />
        }
    </main>
</div>

@if (User.IsSignedIn)
{
    <JiraToasts />
}

<ModalHost />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _ready, _verifying;
    private string? _verifyError;

    private bool OnTimesheet => Links.Read(Nav.ToBaseRelativePath(Nav.Uri), DateOnly.MinValue) is not null;

    private bool OnSetup => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("setup", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        // Error / not-found pages are rendered statically: no browser storage there, just show the page.
        if (!RendererInfo.IsInteractive)
        {
            _ready = true;
            return;
        }

        User.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
        await VerifyAsync();
    }

    /// <summary>Signs this tab in as the user Jira says the stored token belongs to.</summary>
    private async Task VerifyAsync()
    {
        _verifyError = null;
        if (!User.IsSignedIn)
        {
            _verifying = true;
            _verifyError = await Session.RestoreAsync();
            _verifying = false;
            if (_verifyError is not null)
            {
                _ready = true;
                return;
            }
        }

        // Everything except setup needs a verified user.
        if (!OnSetup && !User.IsSignedIn)
        {
            Nav.NavigateTo("setup/connect");
            return; // _ready flips once the navigation lands
        }
        _ready = true;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // The first navigation (to setup, when not signed in) ends the wait; every one moves the active nav link.
        _ready = true;
        InvokeAsync(StateHasChanged);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        User.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
