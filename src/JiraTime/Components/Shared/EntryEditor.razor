@inject JiraClient Jira
@inject WorklogSync Sync

<div class="rounded-lg bg-slate-50 dark:bg-slate-800/60 p-4 ring-1 ring-slate-200 dark:ring-slate-700">
    <div class="grid gap-4 md:grid-cols-[1fr_auto]">
        <div>
            <label class="field-label mt-0" for="issue-search">Jira issue</label>
            @if (_issue is not null)
            {
                <div class="flex items-center gap-2 rounded-md bg-white dark:bg-slate-900 px-3 py-2 text-sm ring-1 ring-slate-300 dark:ring-slate-600">
                    <span class="size-2.5 flex-none rounded-full @IssueColors.For(_issue.Key)"></span>
                    <span class="font-semibold">@_issue.Key</span>
                    <span class="truncate text-slate-600 dark:text-slate-300">@_issue.Summary</span>
                    <button type="button" class="btn-ghost ml-auto" title="Choose another issue" @onclick="() => _issue = null">✕</button>
                </div>
            }
            else
            {
                <Autocomplete TItem="JiraIssue" Id="issue-search" MinLength="1" Placeholder="Search by key or text, e.g. PROJ-123"
                              Search="(q, ct) => Jira.SearchIssuesAsync(Connection, q, ct)"
                              TextOf="_ => string.Empty" OnSelected="i => _issue = i">
                    <ItemTemplate>
                        <div class="flex gap-2 text-sm">
                            <span class="flex-none font-semibold">@context.Key</span>
                            <span class="truncate text-slate-600 dark:text-slate-300">@context.Summary</span>
                        </div>
                    </ItemTemplate>
                </Autocomplete>
                <QuickPicks Label="My sprint" Issues="@Sprint.Select(i => i.ToIssue()).ToList()" OnPick="i => _issue = i" />
                <QuickPicks Label="Recent" Issues="@Recent.Where(r => Sprint.All(i => i.Key != r.Key)).ToList()" OnPick="i => _issue = i" />
            }
        </div>

        <div class="flex gap-3">
            <div>
                <label class="field-label mt-0" for="date">Date</label>
                <input id="date" type="date" class="field" @bind="_date" />
            </div>
            <div>
                <label class="field-label mt-0" for="hours">Hours</label>
                <input id="hours" type="text" inputmode="decimal" class="field w-24" placeholder="1.5" @bind="_hours" @bind:event="oninput" />
            </div>
        </div>
    </div>

    <label class="field-label" for="desc">What did you do? <span class="font-normal text-slate-400">(optional, becomes the Jira worklog comment)</span></label>
    <textarea id="desc" rows="2" class="field" @bind="_description"></textarea>

    @if (_error is not null)
    {
        <div class="alert-error" role="alert">@_error</div>
    }

    <div class="mt-4 flex items-center gap-2">
        @if (!IsNew)
        {
            <button type="button" class="btn-danger ml-auto" disabled="@_busy" @onclick="DeleteAsync">Delete</button>
        }
        <button type="button" class="btn-secondary @(IsNew ? "ml-auto" : "")" @onclick="() => OnDone.InvokeAsync()">Cancel</button>
        <button type="button" class="btn-primary" disabled="@_busy" @onclick="SaveAsync">@(_busy ? "Saving…" : "Save")</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TimeEntry Entry { get; set; } = default!;
    [Parameter] public bool IsNew { get; set; }
    [Parameter, EditorRequired] public JiraConnection Connection { get; set; } = default!;
    [Parameter] public IReadOnlyList<JiraIssue> Recent { get; set; } = [];
    [Parameter] public IReadOnlyList<SprintIssue> Sprint { get; set; } = [];
    /// <summary>Raised after save, delete or cancel.</summary>
    [Parameter] public EventCallback OnDone { get; set; }

    private JiraIssue? _issue;
    private DateOnly _date;
    private string? _hours;
    private string? _description, _error;
    private string? _loadedId;
    private bool _busy;

    protected override void OnParametersSet()
    {
        if (_loadedId == Entry.Id) return; // keep edits across parent re-renders
        _loadedId = Entry.Id;
        _issue = string.IsNullOrEmpty(Entry.IssueKey) ? null : new JiraIssue(Entry.IssueKey, Entry.IssueSummary);
        _date = Entry.Date;
        _hours = Entry.Duration > TimeSpan.Zero ? Format.Hours(Entry.Duration) : "";
        _description = Entry.Description;
        _error = null;
    }

    private async Task SaveAsync()
    {
        if (_issue is null)
        {
            _error = "Pick a Jira issue.";
            return;
        }
        if (Format.ParseHours(_hours) is not { } hours)
        {
            _error = "Enter the hours, e.g. 1.5 or 1:30.";
            return;
        }

        var entry = new TimeEntry
        {
            Id = Entry.Id,
            IssueKey = _issue.Key,
            IssueSummary = _issue.Summary,
            Date = _date,
            Duration = hours,
            Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
            JiraWorklogId = Entry.JiraWorklogId,
            JiraWorklogIssueKey = Entry.JiraWorklogIssueKey,
            CreatedUtc = Entry.CreatedUtc,
        };
        _busy = true;
        // A failed Jira sync still saves the entry; the day list shows it as not synced with a retry.
        var result = await Sync.SaveAsync(Connection, entry);
        _busy = false;
        _error = result.ValidationError;
        if (result.Saved) await OnDone.InvokeAsync();
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        _error = await Sync.DeleteAsync(Connection, Entry);
        _busy = false;
        if (_error is null) await OnDone.InvokeAsync();
    }
}
