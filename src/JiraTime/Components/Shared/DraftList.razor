@* Proposed entries for one day: editable and removable one by one, saved only on Accept. *@
<div class="rounded-lg border-2 border-dashed border-blue-300 bg-blue-50/50 p-4 dark:border-blue-800 dark:bg-blue-950/30">
    <div class="flex flex-wrap items-center gap-2">
        <h3 class="text-sm font-semibold">Suggested entries</h3>
        <span class="text-xs text-slate-500 dark:text-slate-400">Drafts. Nothing is saved or sent to Jira until you accept.</span>
    </div>

    <ul class="mt-3 space-y-2">
        @foreach (var d in Drafts)
        {
            <li class="flex flex-wrap items-center gap-2" data-draft>
                <span class="size-2.5 flex-none rounded-full @(d.IssueKey == "" ? "bg-slate-300" : IssueColors.For(d.IssueKey))"></span>
                <select class="field w-auto min-w-56 max-w-md py-1" aria-label="Issue" value="@d.IssueKey" @onchange="e => PickIssue(d, e)">
                    <option value="">Choose issue…</option>
                    @foreach (var i in ChoicesFor(d))
                    {
                        <option value="@i.Key">@i.Key @i.Summary</option>
                    }
                </select>
                <input type="text" inputmode="decimal" class="field w-20 py-1" aria-label="Hours" value="@Format.Hours(d.Duration)" @onchange="e => SetHours(d, e)" />
                <span class="text-sm text-slate-500 dark:text-slate-400">h</span>
                <button type="button" class="btn-ghost" title="Remove this suggestion" @onclick="() => Remove(d)">✕</button>
                @if (Errors.GetValueOrDefault(d.Id) is { } error)
                {
                    <span class="basis-full pl-5 text-xs text-red-700 dark:text-red-400" role="alert">@error</span>
                }
            </li>
        }
    </ul>

    <div class="mt-4 flex items-center gap-2">
        <span class="text-sm text-slate-500 dark:text-slate-400">@Format.Hours(Drafts.Aggregate(TimeSpan.Zero, (t, d) => t + d.Duration)) h suggested</span>
        <button type="button" class="btn-secondary ml-auto" disabled="@Busy" @onclick="() => OnDiscard.InvokeAsync()">Discard</button>
        <button type="button" class="btn-primary" disabled="@(Busy || Drafts.Count == 0)" @onclick="() => OnAccept.InvokeAsync()">
            @(Busy ? "Saving…" : Drafts.Count == 1 ? "Accept 1 entry" : $"Accept {Drafts.Count} entries")
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<TimeEntry> Drafts { get; set; } = [];
    /// <summary>Issues offered in each row's picker (sprint and recent).</summary>
    [Parameter] public IReadOnlyList<JiraIssue> Choices { get; set; } = [];
    /// <summary>Draft id → why it could not be saved.</summary>
    [Parameter] public IReadOnlyDictionary<string, string> Errors { get; set; } = new Dictionary<string, string>();
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnAccept { get; set; }
    [Parameter] public EventCallback OnDiscard { get; set; }
    /// <summary>Raised after a draft was edited or removed.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private IEnumerable<JiraIssue> ChoicesFor(TimeEntry d) =>
        d.IssueKey == "" || Choices.Any(c => c.Key == d.IssueKey)
            ? Choices
            : Choices.Prepend(new JiraIssue(d.IssueKey, d.IssueSummary));

    private Task PickIssue(TimeEntry d, ChangeEventArgs e)
    {
        var key = e.Value?.ToString() ?? "";
        d.IssueKey = key;
        d.IssueSummary = ChoicesFor(d).FirstOrDefault(c => c.Key == key)?.Summary ?? "";
        return OnChanged.InvokeAsync();
    }

    private Task SetHours(TimeEntry d, ChangeEventArgs e)
    {
        // Unreadable input counts as zero, which Accept then reports for that row.
        d.Duration = Format.ParseHours(e.Value?.ToString()) ?? TimeSpan.Zero;
        return OnChanged.InvokeAsync();
    }

    private Task Remove(TimeEntry d)
    {
        Drafts.Remove(d);
        return OnChanged.InvokeAsync();
    }
}
