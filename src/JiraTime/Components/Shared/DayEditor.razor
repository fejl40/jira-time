@* One day's work as editable rows. Nothing is written until Save day, which also updates Jira.
   The unsaved changes live in a DayWork owned by the page, so they survive picking another day. *@
@inject JiraClient Jira
@inject WorklogSync Sync

<div>
    <ul class="divide-y divide-slate-100 dark:divide-slate-800">
        @foreach (var row in Rows)
        {
            var e = row.Entry;
            <li class="flex flex-wrap items-center gap-2 py-2.5 @RowClass(row)" data-row="@(row.Removed ? "removed" : row.IsDraft ? "draft" : "saved")">
                <span class="size-2.5 flex-none rounded-full @(e.IssueKey == "" ? "bg-slate-300" : IssueColors.For(e.IssueKey))"></span>
                @if (row.Removed)
                {
                    <div class="min-w-56 flex-1 basis-64 truncate text-sm text-slate-500 line-through dark:text-slate-400">
                        <span class="font-semibold">@e.IssueKey</span> @e.IssueSummary
                    </div>
                    <span class="w-20 text-right text-sm tabular-nums text-slate-500 line-through dark:text-slate-400">@Format.Hours(e.Duration) h</span>
                    <span class="min-w-40 flex-1 basis-48 truncate text-sm text-slate-500 line-through dark:text-slate-400">@e.Description</span>
                    <span class="w-48 text-right text-xs font-medium text-red-700 dark:text-red-400">@(e.JiraWorklogId is null ? "Removed" : "Deletes the worklog in Jira")</span>
                    <button type="button" class="btn-ghost text-xs" title="Keep this row" @onclick="() => Restore(row)">Undo</button>
                }
                else
                {
                    <div class="min-w-56 flex-1 basis-64">
                        <IssuePicker Id="@($"issue-{e.Id}")" Value="new JiraIssue(e.IssueKey, e.IssueSummary)" Sprint="Sprint" Recent="Recent"
                                     Earlier="Earlier" Statuses="Statuses"
                                     Search="(q, ct) => Jira.SearchIssuesAsync(Connection, q, ct)" OnSelected="i => PickIssue(row, i)" />
                    </div>
                    <div class="flex items-center gap-1">
                        <input type="text" inputmode="decimal" class="field w-20 py-1.5 text-right" aria-label="Hours" placeholder="h"
                               id="hours-@e.Id" data-hours value="@HoursText(e)" @onchange="ev => SetHours(row, ev)" />
                        <span class="text-sm text-slate-500 dark:text-slate-400">h</span>
                    </div>
                    <input type="text" class="field min-w-40 flex-1 basis-48 py-1.5" aria-label="Comment" placeholder="Comment (optional)"
                           list="@CommentListId(e.IssueKey)" data-comment value="@e.Description" @onchange="ev => SetDescription(row, ev)" />
                    <span class="w-32 text-right text-xs" title="@e.SyncError">
                        @if (row.IsDraft)
                        {
                            <span class="font-medium text-blue-700 dark:text-blue-300">@(Work.Suggested.Contains(e.Id) ? "Suggested" : "New")</span>
                        }
                        else if (Work.IsChanged(row.Saved!))
                        {
                            <span class="font-medium text-blue-700 dark:text-blue-300">Changed</span>
                        }
                        else if (e.IsSynced)
                        {
                            <span class="text-emerald-700 dark:text-emerald-400" title="@(e.FromJira ? "Logged in Jira and imported" : null)">✓ @(e.FromJira ? "From Jira" : "In Jira")</span>
                        }
                        else
                        {
                            <span class="font-medium text-amber-700 dark:text-amber-400">Not in Jira</span>
                        }
                    </span>
                    <button type="button" class="btn-ghost" title="Remove" aria-label="Remove" @onclick="() => Remove(row)">✕</button>
                }
                @if (_errors.GetValueOrDefault(e.Id) is { } error)
                {
                    <span class="basis-full pl-5 text-xs text-red-700 dark:text-red-400" role="alert">@error</span>
                }
                else if (!row.IsDraft && !row.Removed && !e.IsSynced && e.SyncError is not null && !Work.IsChanged(row.Saved!))
                {
                    <span class="basis-full pl-5 text-xs text-amber-700 dark:text-amber-400">Jira: @e.SyncError</span>
                }
                @if (!row.Removed && Statuses.GetValueOrDefault(e.IssueKey) is { IsDone: true } done)
                {
                    <span class="basis-full pl-5 text-xs text-amber-700 dark:text-amber-400" data-not-todo>
                        @e.IssueKey is @done.Status in Jira, so this time is logged on an issue that isn't to do any more.
                    </span>
                }
            </li>
        }
        @if (Rows.Count == 0)
        {
            <li class="py-6 text-center text-sm text-slate-500 dark:text-slate-400">No work on this day.</li>
        }
    </ul>

    @* Recent comments per issue, suggested by the comment fields. *@
    @foreach (var key in Rows.Select(r => r.Entry.IssueKey).Where(k => k != "").Distinct())
    {
        @if (Comments.GetValueOrDefault(key) is { Count: > 0 } comments)
        {
            <datalist id="@CommentListId(key)">
                @foreach (var c in comments)
                {
                    <option value="@c"></option>
                }
            </datalist>
        }
    }

    <div class="mt-3 flex flex-wrap items-center gap-2">
        <button type="button" class="btn-secondary" @onclick="AddRow">+ Add issue</button>
        @if (Expected > TimeSpan.Zero && Total < Expected)
        {
            <button type="button" class="btn-ghost" @onclick="FillRest">Fill the rest (@Format.Hours(Expected - Total) h)</button>
        }
        @if (Previous is { } previous)
        {
            <button type="button" class="btn-ghost" data-copy-previous
                    title="Same issues and split as @previous.Date.ToString("dddd d MMM", System.Globalization.CultureInfo.InvariantCulture), scaled to the hours missing"
                    @onclick="CopyPrevious">Copy @previous.Date.ToString("ddd d MMM", System.Globalization.CultureInfo.InvariantCulture)</button>
        }
    </div>

    @if (_errors.GetValueOrDefault(WorklogSync.DayResult.DayError) is { } dayError)
    {
        <div class="alert-error" role="alert">@dayError</div>
    }
    @if (_notice is not null)
    {
        <div class="mt-3 text-sm text-amber-700 dark:text-amber-400" role="status">@_notice</div>
    }

    <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-4 dark:border-slate-800">
        <span class="text-sm">
            <Count Value="Total" Zero="0" Unit=" h" Class="@($"font-semibold tabular-nums {(Expected > TimeSpan.Zero && Total != Expected ? "text-amber-700 dark:text-amber-400" : "")}")" data-day-total />
            @if (Expected > TimeSpan.Zero)
            {
                <span class="text-slate-500 dark:text-slate-400"> of @Format.Hours(Expected) h</span>
            }
        </span>
        @if (HasChanges)
        {
            <span class="text-xs text-blue-700 dark:text-blue-300">Unsaved changes</span>
            <button type="button" class="btn-secondary ml-auto" disabled="@_busy" @onclick="ResetAsync">Discard changes</button>
        }
        <button type="button" class="btn-primary @(HasChanges ? "" : "ml-auto")" disabled="@(_busy || !CanSave)" @onclick="SaveAsync" data-save-day>
            @(_busy ? "Saving…" : "Save day")
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DateOnly Date { get; set; }
    /// <summary>The day's saved entries.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<TimeEntry> Saved { get; set; } = [];
    /// <summary>The day's unsaved changes. Owned by the page, so the grid shows them and they outlive this editor.</summary>
    [Parameter, EditorRequired] public DayWork Work { get; set; } = default!;
    /// <summary>Recently used issues, offered in the issue picker after the sprint.</summary>
    [Parameter] public IReadOnlyList<JiraIssue> Recent { get; set; } = [];
    /// <summary>Recent comments per issue key, newest first.</summary>
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<string>> Comments { get; set; } = new Dictionary<string, IReadOnlyList<string>>();
    [Parameter] public IReadOnlyList<IssueWithStatus> Sprint { get; set; } = [];
    /// <summary>Issues that were to do earlier in the period, offered in the picker after the sprint.</summary>
    [Parameter] public IReadOnlyList<IssueWithStatus> Earlier { get; set; } = [];
    /// <summary>Current Jira status per issue key; rows on Done issues get a note.</summary>
    [Parameter] public IReadOnlyDictionary<string, IssueWithStatus> Statuses { get; set; } = new Dictionary<string, IssueWithStatus>();
    /// <summary>Raised with the key when an issue is picked, so the page can look up its status.</summary>
    [Parameter] public EventCallback<string> OnIssuePicked { get; set; }
    [Parameter, EditorRequired] public JiraConnection Connection { get; set; } = default!;
    /// <summary>Hours the day should have (zero on weekends, holidays and days off).</summary>
    [Parameter] public TimeSpan Expected { get; set; }
    /// <summary>The latest earlier day with work, offered to copy.</summary>
    [Parameter] public (DateOnly Date, IReadOnlyList<TimeEntry> Rows)? Previous { get; set; }
    /// <summary>Raised after rows were added, edited or removed.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Raised after the day was saved.</summary>
    [Parameter] public EventCallback<WorklogSync.DayResult> OnSaved { get; set; }
    /// <summary>Raised when the user discards the unsaved changes.</summary>
    [Parameter] public EventCallback OnDiscard { get; set; }

    /// <param name="Saved">The stored entry for saved rows; null for new rows.</param>
    private record RowView(TimeEntry Entry, TimeEntry? Saved, bool Removed)
    {
        public bool IsDraft => Saved is null;
    }

    private DateOnly? _loadedDate;
    private Dictionary<string, string> _errors = [];
    private string? _notice;
    private bool _busy;

    private List<RowView> Rows =>
        Saved.Select(s => new RowView(Work.View(s), s, Work.IsRemoved(s)))
            .Concat(Work.Drafts.Select(d => new RowView(d, null, false)))
            .ToList();

    private TimeSpan Total => Work.Total(Saved);

    private bool HasChanges => Work.HasChanges(Saved);

    /// <summary>Save day also retries saved work that Jira doesn't have yet.</summary>
    private bool CanSave => HasChanges || Saved.Any(s => !s.IsSynced);

    private static string RowClass(RowView row) =>
        row.Removed ? "-mx-2 rounded-md bg-red-50/60 px-2 dark:bg-red-950/20"
        : row.IsDraft ? "-mx-2 rounded-md bg-blue-50/60 px-2 dark:bg-blue-950/30" : "";

    protected override void OnParametersSet()
    {
        if (_loadedDate == Date) return;
        _loadedDate = Date;
        _errors = [];
        _notice = null;
    }

    /// <summary>The entry to change for a row: the draft itself, or the copy of a saved entry.</summary>
    private TimeEntry Editable(RowView row)
    {
        if (row.Saved is { } s) return Work.Edit(s);
        Work.Touched(row.Entry);
        return row.Entry;
    }

    private string HoursText(TimeEntry e) =>
        Work.BadHours.TryGetValue(e.Id, out var text) ? text : Format.Hours(e.Duration);

    private static string CommentListId(string issueKey) =>
        issueKey == "" ? "" : "comments-" + string.Concat(issueKey.Where(char.IsLetterOrDigit));

    private async Task PickIssue(RowView row, JiraIssue issue)
    {
        var e = Editable(row);
        e.IssueKey = issue.Key;
        e.IssueSummary = issue.Summary;
        _errors.Remove(e.Id);
        await Changed();
        if (issue.Key != "") await OnIssuePicked.InvokeAsync(issue.Key);
    }

    private Task SetHours(RowView row, ChangeEventArgs ev)
    {
        var e = Editable(row);
        var text = ev.Value?.ToString() ?? "";
        var hours = Format.ParseHours(text);
        // Keep what was typed when it can't be read; Save day reports it.
        if (hours is null && text.Trim() != "") Work.BadHours[e.Id] = text;
        else Work.BadHours.Remove(e.Id);
        e.Duration = hours ?? TimeSpan.Zero;
        _errors.Remove(e.Id);
        return Changed();
    }

    private Task SetDescription(RowView row, ChangeEventArgs ev)
    {
        var text = ev.Value?.ToString()?.Trim();
        Editable(row).Description = string.IsNullOrEmpty(text) ? null : text;
        return Changed();
    }

    /// <summary>Adds an empty row, optionally on an issue. Returns it so the caller can focus it.</summary>
    public async Task<TimeEntry> AddRowAsync(JiraIssue? issue = null)
    {
        var draft = new TimeEntry { IssueKey = issue?.Key ?? "", IssueSummary = issue?.Summary ?? "", Date = Date };
        Work.Drafts.Add(draft);
        await Changed();
        return draft;
    }

    private Task AddRow() => AddRowAsync();

    private Task FillRest()
    {
        var current = Work.RowsToSave(Saved).Where(e => e.Duration > TimeSpan.Zero).ToList();
        var day = new DayInfo(Date, DayKind.Workday, null) { Hours = Expected };
        Work.Drafts.AddRange(DayFiller.Propose(day, current, Sprint));
        return Changed();
    }

    /// <summary>
    /// Adds the previous worked day's issues, scaled to the hours still missing (or as they were when
    /// nothing is missing). Untouched suggestions are replaced by the copy.
    /// </summary>
    private Task CopyPrevious()
    {
        if (Previous is not { } previous) return Task.CompletedTask;
        foreach (var d in Work.Drafts.Where(d => Work.Suggested.Contains(d.Id)).ToList()) Work.Drafts.Remove(d);
        Work.Suggested.Clear();
        var missing = Expected - Total;
        Work.Drafts.AddRange(DayFiller.Copy(Date, previous.Rows, missing > TimeSpan.Zero ? missing : null));
        return Changed();
    }

    private Task Remove(RowView row)
    {
        if (row.Saved is { } s) Work.Removed.Add(s.Id);
        else
        {
            Work.Drafts.Remove(row.Entry);
            Work.Suggested.Remove(row.Entry.Id);
            Work.BadHours.Remove(row.Entry.Id);
        }
        _errors.Remove(row.Entry.Id);
        return Changed();
    }

    private Task Restore(RowView row)
    {
        Work.Removed.Remove(row.Saved!.Id);
        return Changed();
    }

    private Task Changed()
    {
        _notice = null;
        return OnChanged.InvokeAsync();
    }

    private async Task ResetAsync()
    {
        _errors = [];
        _notice = null;
        await OnDiscard.InvokeAsync();
    }

    /// <summary>Saves the day's rows and updates Jira. Public for the Ctrl+S shortcut.</summary>
    public async Task SaveAsync()
    {
        if (_busy || !CanSave) return;
        foreach (var (id, _) in Work.BadHours) _errors[id] = "Enter the hours, e.g. 1.5 or 1:30.";
        if (Work.BadHours.Count > 0) return;

        _busy = true;
        var result = await Sync.SaveDayAsync(Connection, Date, Work.RowsToSave(Saved));
        _busy = false;
        _errors = result.Errors.ToDictionary();
        if (!result.Saved) return;

        _notice = result.SyncFailures > 0
            ? $"Saved, but {result.SyncFailures} {(result.SyncFailures == 1 ? "change" : "changes")} could not be sent to Jira yet. Use Sync now to retry."
            : null;
        await OnSaved.InvokeAsync(result);
    }
}
