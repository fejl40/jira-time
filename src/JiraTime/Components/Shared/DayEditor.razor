@* One day's work as editable rows. Nothing is written until Save day, which also updates Jira. *@
@inject JiraClient Jira
@inject WorklogSync Sync

<div>
    <ul class="divide-y divide-slate-100 dark:divide-slate-800">
        @foreach (var row in Rows)
        {
            var e = row.Entry;
            <li class="flex flex-wrap items-center gap-2 py-2.5 @(row.IsDraft ? "-mx-2 rounded-md bg-blue-50/60 px-2 dark:bg-blue-950/30" : "")" data-row="@(row.IsDraft ? "draft" : "saved")">
                <span class="size-2.5 flex-none rounded-full @(e.IssueKey == "" ? "bg-slate-300" : IssueColors.For(e.IssueKey))"></span>
                <div class="min-w-56 flex-1 basis-64">
                    @if (_searching.Contains(e.Id))
                    {
                        <Autocomplete TItem="JiraIssue" Id="@($"search-{e.Id}")" MinLength="1" Placeholder="Search by key or text"
                                      Search="(q, ct) => Jira.SearchIssuesAsync(Connection, q, ct)"
                                      TextOf="_ => string.Empty" OnSelected="i => PickIssue(e, i)">
                            <ItemTemplate>
                                <div class="flex gap-2 text-sm">
                                    <span class="flex-none font-semibold">@context.Key</span>
                                    <span class="truncate text-slate-600 dark:text-slate-300">@context.Summary</span>
                                </div>
                            </ItemTemplate>
                        </Autocomplete>
                    }
                    else
                    {
                        <select class="field py-1.5" aria-label="Issue" value="@e.IssueKey" @onchange="ev => OnIssueSelected(e, ev)">
                            <option value="">Choose issue…</option>
                            @foreach (var i in ChoicesFor(e))
                            {
                                <option value="@i.Key">@i.Key @i.Summary</option>
                            }
                            <option value="@SearchOption">Search Jira…</option>
                        </select>
                    }
                </div>
                <div class="flex items-center gap-1">
                    <input type="text" inputmode="decimal" class="field w-20 py-1.5 text-right" aria-label="Hours" placeholder="h"
                           value="@HoursText(e)" @onchange="ev => SetHours(e, ev)" />
                    <span class="text-sm text-slate-500 dark:text-slate-400">h</span>
                </div>
                <input type="text" class="field min-w-40 flex-1 basis-48 py-1.5" aria-label="Comment" placeholder="Comment (optional)"
                       value="@e.Description" @onchange="ev => SetDescription(e, ev)" />
                <span class="w-24 text-right text-xs" title="@e.SyncError">
                    @if (row.IsDraft)
                    {
                        <span class="font-medium text-blue-700 dark:text-blue-300">@(row.Suggested ? "Suggested" : "New")</span>
                    }
                    else if (IsChanged(e))
                    {
                        <span class="font-medium text-blue-700 dark:text-blue-300">Changed</span>
                    }
                    else if (e.IsSynced)
                    {
                        <span class="text-emerald-700 dark:text-emerald-400">✓ In Jira</span>
                    }
                    else
                    {
                        <span class="font-medium text-amber-700 dark:text-amber-400">Not in Jira</span>
                    }
                </span>
                <button type="button" class="btn-ghost" title="Remove" aria-label="Remove" @onclick="() => Remove(row)">✕</button>
                @if (_errors.GetValueOrDefault(e.Id) is { } error)
                {
                    <span class="basis-full pl-5 text-xs text-red-700 dark:text-red-400" role="alert">@error</span>
                }
                else if (!row.IsDraft && !e.IsSynced && e.SyncError is not null && !IsChanged(e))
                {
                    <span class="basis-full pl-5 text-xs text-amber-700 dark:text-amber-400">Jira: @e.SyncError</span>
                }
            </li>
        }
        @if (Rows.Count == 0)
        {
            <li class="py-6 text-center text-sm text-slate-500 dark:text-slate-400">No work on this day.</li>
        }
    </ul>

    <div class="mt-3 flex flex-wrap items-center gap-2">
        <button type="button" class="btn-secondary" @onclick="AddRow">+ Add issue</button>
        @if (Expected > TimeSpan.Zero && Total < Expected)
        {
            <button type="button" class="btn-ghost" @onclick="FillRest">Fill the rest (@Format.Hours(Expected - Total) h)</button>
        }
    </div>

    @if (_errors.GetValueOrDefault(WorklogSync.DayResult.DayError) is { } dayError)
    {
        <div class="alert-error" role="alert">@dayError</div>
    }
    @if (_notice is not null)
    {
        <div class="mt-3 text-sm text-amber-700 dark:text-amber-400" role="status">@_notice</div>
    }

    <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-4 dark:border-slate-800">
        <span class="text-sm">
            <span class="font-semibold tabular-nums @(Expected > TimeSpan.Zero && Total != Expected ? "text-amber-700 dark:text-amber-400" : "")" data-day-total>@(Format.Hours(Total) is { Length: > 0 } t ? t : "0") h</span>
            @if (Expected > TimeSpan.Zero)
            {
                <span class="text-slate-500 dark:text-slate-400"> of @Format.Hours(Expected) h</span>
            }
        </span>
        @if (IsDirty)
        {
            <span class="text-xs text-blue-700 dark:text-blue-300">Unsaved changes</span>
            <button type="button" class="btn-secondary ml-auto" disabled="@_busy" @onclick="ResetAsync">Discard changes</button>
        }
        <button type="button" class="btn-primary @(IsDirty ? "" : "ml-auto")" disabled="@(_busy || !IsDirty)" @onclick="SaveAsync">
            @(_busy ? "Saving…" : "Save day")
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DateOnly Date { get; set; }
    /// <summary>The day's saved entries.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<TimeEntry> Saved { get; set; } = [];
    /// <summary>Unsaved new rows for the day (suggestions and added issues). Shared with the page so the grid shows them.</summary>
    [Parameter, EditorRequired] public List<TimeEntry> Drafts { get; set; } = [];
    /// <summary>Ids of drafts that came from a suggestion rather than + Add issue.</summary>
    [Parameter] public IReadOnlySet<string> SuggestedIds { get; set; } = new HashSet<string>();
    [Parameter] public IReadOnlyList<JiraIssue> Choices { get; set; } = [];
    [Parameter] public IReadOnlyList<SprintIssue> Sprint { get; set; } = [];
    [Parameter, EditorRequired] public JiraConnection Connection { get; set; } = default!;
    /// <summary>Hours the day should have (zero on weekends, holidays and days off).</summary>
    [Parameter] public TimeSpan Expected { get; set; }
    /// <summary>Raised after drafts were added, edited or removed.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Raised after the day was saved.</summary>
    [Parameter] public EventCallback<WorklogSync.DayResult> OnSaved { get; set; }
    /// <summary>Raised when the user discards the unsaved changes.</summary>
    [Parameter] public EventCallback OnDiscard { get; set; }

    private const string SearchOption = "__search";

    private record RowView(TimeEntry Entry, bool IsDraft, bool Suggested);

    private string? _loadedKey;
    private DateOnly? _loadedDate;
    private List<TimeEntry> _copies = [];
    private readonly HashSet<string> _searching = [];
    private readonly Dictionary<string, string> _hoursText = [];
    private Dictionary<string, string> _errors = [];
    private string? _notice;
    private bool _busy;

    private List<RowView> Rows =>
        _copies.Select(c => new RowView(c, false, false))
            .Concat(Drafts.Select(d => new RowView(d, true, SuggestedIds.Contains(d.Id))))
            .ToList();

    private TimeSpan Total => Rows.Aggregate(TimeSpan.Zero, (t, r) => t + r.Entry.Duration);

    private bool IsChanged(TimeEntry copy) =>
        Saved.FirstOrDefault(s => s.Id == copy.Id) is { } s
        && (s.IssueKey != copy.IssueKey || s.Duration != copy.Duration || s.Description != copy.Description);

    private bool IsDirty =>
        Drafts.Count > 0 || _copies.Count != Saved.Count || _copies.Any(IsChanged) || Saved.Any(s => !s.IsSynced);

    protected override void OnParametersSet()
    {
        // Reload the working copies when the day or its saved entries change, not on every re-render.
        var key = $"{Date}|{string.Join(',', Saved.Select(s => $"{s.Id}:{s.UpdatedUtc.Ticks}:{s.IsSynced}"))}";
        if (key == _loadedKey) return;
        _loadedKey = key;
        LoadCopies();
        _errors = [];
        if (_loadedDate != Date) _notice = null; // keep "saved, but…" after a save
        _loadedDate = Date;
    }

    private void LoadCopies()
    {
        _copies = Saved.Select(s => s.Copy()).ToList();
        _hoursText.Clear();
        _searching.Clear();
    }

    private string HoursText(TimeEntry e) =>
        _hoursText.TryGetValue(e.Id, out var text) ? text : Format.Hours(e.Duration);

    private IEnumerable<JiraIssue> ChoicesFor(TimeEntry e) =>
        e.IssueKey == "" || Choices.Any(c => c.Key == e.IssueKey)
            ? Choices
            : Choices.Prepend(new JiraIssue(e.IssueKey, e.IssueSummary));

    private async Task OnIssueSelected(TimeEntry e, ChangeEventArgs ev)
    {
        var key = ev.Value?.ToString() ?? "";
        if (key == SearchOption)
        {
            _searching.Add(e.Id);
            return;
        }
        await PickIssue(e, ChoicesFor(e).FirstOrDefault(c => c.Key == key) ?? new JiraIssue("", ""));
    }

    private Task PickIssue(TimeEntry e, JiraIssue issue)
    {
        e.IssueKey = issue.Key;
        e.IssueSummary = issue.Summary;
        _searching.Remove(e.Id);
        _errors.Remove(e.Id);
        return Changed();
    }

    private Task SetHours(TimeEntry e, ChangeEventArgs ev)
    {
        var text = ev.Value?.ToString() ?? "";
        var hours = Format.ParseHours(text);
        // Keep what was typed when it can't be read; Save day reports it.
        if (hours is null && text.Trim() != "") _hoursText[e.Id] = text;
        else _hoursText.Remove(e.Id);
        e.Duration = hours ?? TimeSpan.Zero;
        _errors.Remove(e.Id);
        return Changed();
    }

    private Task SetDescription(TimeEntry e, ChangeEventArgs ev)
    {
        var text = ev.Value?.ToString()?.Trim();
        e.Description = string.IsNullOrEmpty(text) ? null : text;
        return Changed();
    }

    private Task AddRow()
    {
        Drafts.Add(new TimeEntry { IssueKey = "", Date = Date });
        return Changed();
    }

    private Task FillRest()
    {
        var current = Rows.Select(r => r.Entry).Where(e => e.Duration > TimeSpan.Zero).ToList();
        var day = new DayInfo(Date, DayKind.Workday, null) { Hours = Expected };
        Drafts.AddRange(DayFiller.Propose(day, current, Sprint));
        return Changed();
    }

    private Task Remove(RowView row)
    {
        if (row.IsDraft) Drafts.Remove(row.Entry);
        else _copies.Remove(row.Entry);
        _errors.Remove(row.Entry.Id);
        return Changed();
    }

    private Task Changed()
    {
        _notice = null;
        return OnChanged.InvokeAsync();
    }

    private async Task ResetAsync()
    {
        LoadCopies();
        _errors = [];
        _notice = null;
        await OnDiscard.InvokeAsync();
    }

    private async Task SaveAsync()
    {
        foreach (var (id, _) in _hoursText) _errors[id] = "Enter the hours, e.g. 1.5 or 1:30.";
        if (_hoursText.Count > 0) return;

        _busy = true;
        var rows = Rows.Select(r => r.Entry).ToList();
        var result = await Sync.SaveDayAsync(Connection, Date, rows);
        _busy = false;
        _errors = result.Errors.ToDictionary();
        if (!result.Saved) return;

        Drafts.Clear();
        _notice = result.SyncFailures > 0
            ? $"Saved, but {result.SyncFailures} {(result.SyncFailures == 1 ? "change" : "changes")} could not be sent to Jira yet. Use Sync now to retry."
            : null;
        _loadedKey = null; // reload copies from the fresh saved entries
        await OnSaved.InvokeAsync(result);
    }
}
