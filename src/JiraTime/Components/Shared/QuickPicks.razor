@* A labelled row of one-click issue chips. Renders nothing when empty. *@
@if (Issues.Count > 0)
{
    <div class="mt-2 flex flex-wrap items-center gap-1.5">
        <span class="mr-1 text-xs text-slate-500 dark:text-slate-400">@Label</span>
        @foreach (var issue in Issues)
        {
            <button type="button" title="@issue.Summary" @onclick="() => OnPick.InvokeAsync(issue)"
                    class="rounded-full bg-white dark:bg-slate-900 px-2.5 py-1 text-xs ring-1 ring-slate-300 dark:ring-slate-600 hover:ring-blue-600">
                @issue.Key
            </button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<JiraIssue> Issues { get; set; } = [];
    [Parameter] public EventCallback<JiraIssue> OnPick { get; set; }
}
