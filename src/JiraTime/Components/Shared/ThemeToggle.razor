@* Cycles light → dark → system. The choice is kept in this browser (see wwwroot/theme.js). *@
@inject IJSRuntime JS

<button type="button" class="rounded-md px-2 py-1.5 text-slate-300 hover:bg-white/10 hover:text-white"
        title="Theme: @Label (click to change)" aria-label="Theme: @Label" @onclick="CycleAsync">
    @if (_mode == "light")
    {
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    }
    else if (_mode == "dark")
    {
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
    }
    else
    {
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
    }
</button>

@code {
    private static readonly string[] Modes = ["light", "dark", "system"];
    private string _mode = "system";

    private string Label => _mode switch { "light" => "Light", "dark" => "Dark", _ => "System" };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _mode = await JS.InvokeAsync<string>("jiraTheme.get");
        StateHasChanged();
    }

    private async Task CycleAsync()
    {
        var next = Modes[(Array.IndexOf(Modes, _mode) + 1) % Modes.Length];
        _mode = await JS.InvokeAsync<string>("jiraTheme.set", next);
    }
}
