@page "/"
@page "/period/{StartText}"
@inject ShownPeriod Shown
@inject CurrentUser User
@inject NavigationManager Nav
@inject ModalService Modals
@inject MotionScript Animations
@implements IDisposable

@* Shows a period: the URL and selected day, modals, focus and animations. Loading, saving and syncing are
   ShownPeriod; the rules PeriodSheet; the markup Components/Sheet. *@

<PageTitle>Timesheet · Jira Time</PageTitle>

<NavigationLock ConfirmExternalNavigation="@Shown.HasUnsaved" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

@if (Shown.Sheet is { } sheet)
{
@* The day's rows look up statuses and search Jira through the page's IssueStatuses. *@
<CascadingValue Value="Shown.Statuses" IsFixed="true">
<DayKeys @ref="_keys" OnSave="SaveAllAsync" OnMove="d => SelectDay(Shown.Day.AddDays(d))" OnAddRow="AddRowFromKeyboardAsync" />
<div class="mx-auto max-w-7xl space-y-6 overflow-x-clip">
    <PeriodHeader Sheet="sheet" Waits="Shown.Waits"
                  OnSync="Shown.SyncAsync" OnFillPeriod="FillPeriod" OnSaveAll="SaveAllAsync" OnDiscardAll="Shown.DiscardAll" />

    <PeriodReminders Sheet="sheet" Previous="Shown.Extras.Previous" JiraError="@Shown.Extras.JiraError" Waits="Shown.Waits"
                     OnRetry="Shown.RetryAsync" />

    @* A new period slides in from the side it comes from. While Jira is read the period shows as pending. *@
    <div @key="sheet.Period" class="waiting-dim space-y-6 @Motion.Slide(Shown.Slide)" aria-busy="@JiraWaits.Aria(Shown.Waits.PeriodPending)" data-period-pending>
        <DayList Sheet="sheet" Selected="Shown.Day" OnSelect="d => SelectDay(d)" />

        <PeriodGrid Sheet="sheet" Selected="Shown.Day" JiraBaseUrl="@User.Jira?.Connection.BaseUrl"
                    Cascade="_cascade" JustSaved="Shown.SaveMotion.JustSaved" SentToJira="Shown.SaveMotion.SentToJira"
                    OnSelectDay="d => SelectDay(d, focus: true)" OnCellClicked="CellClicked" />
    </div>

    <DayPanel @ref="_panel" Shown="Shown" Day="Shown.Day" OnChanged="StateHasChanged" />
</div>
</CascadingValue>
}
else
{
    <Waiting Block Label="Reading your time from Jira…" Class="mx-auto max-w-7xl py-10 text-sm text-muted" data-loading />
}

@code {
    // Period and day are kept in the URL (read with Links.Read); a change to these re-renders the page.
    [Parameter] public string? StartText { get; set; }
    [SupplyParameterFromQuery(Name = "day")] public string? DayText { get; set; }

    private DayPanel? _panel;
    private DayKeys? _keys;
    /// <summary>True for the render right after Fill period, so its suggestions drop in day by day.</summary>
    private bool _cascade;

    private PeriodSheet Sheet => Shown.Sheet!;

    protected override void OnInitialized() => Shown.Waits.Changed += StateHasChanged;

    public void Dispose() => Shown.Waits.Changed -= StateHasChanged;

    protected override Task OnParametersSetAsync() =>
        Shown.ShowAsync(LinkTo(Nav.Uri) ?? new TimesheetLink(Period.For(Shown.Today), null));

    private TimesheetLink? LinkTo(string uri) => Links.Read(Nav.ToBaseRelativePath(Nav.ToAbsoluteUri(uri).ToString()), Shown.Today);

    private void FillPeriod()
    {
        Sheet.FillPeriod();
        _cascade = true;
    }

    /// <summary>Save all (and Ctrl+S): lists the changes in SaveAllModal and saves once the user confirms.</summary>
    private async Task SaveAllAsync()
    {
        if (User.Jira is null || !Shown.Waits.CanStart || Sheet.UnsavedDays.Count == 0) return;
        var changes = new Dictionary<string, object?> { [nameof(SaveAllModal.Changes)] = UnsavedChanges.Of(Sheet) };
        if (!await Modals.ShowAsync<SaveAllModal, bool>(changes) || !Shown.Waits.CanStart) return;
        // Removed rows of the shown day shrink away once it is saved, before the period is read again.
        var toFix = await Shown.SaveDaysAsync(() => Shown.SaveMotion.JustSaved.Contains(Shown.Day)
            ? Animations.CollapseAsync(MotionScript.RemovedRows) : Task.CompletedTask);
        if (toFix is { } day) SelectDay(day);
    }

    /// <summary>Selects a day by putting it in the URL; <see cref="OnParametersSetAsync"/> shows it.</summary>
    /// <param name="focus">Focus the day's first hours field once shown (picked with the mouse).</param>
    private void SelectDay(DateOnly day, bool focus = false)
    {
        if (focus) _keys?.FocusFirstHours();
        if (day != Shown.Day) Nav.NavigateTo(Links.To(day), replace: true);
    }

    /// <summary>A grid cell: open the day on that issue's row, adding an empty row for it when the day has none.</summary>
    private void CellClicked((DateOnly Day, PeriodRow Row) cell)
    {
        var (day, row) = cell;
        if (row.Key != "") _keys?.Focus($"hours-{Sheet.RowFor(day, row.Key, row.Summary).Id}");
        SelectDay(day, focus: row.Key == "");
    }

    /// <summary>Asks before leaving the period (or the page) with unsaved changes. Picking another day of the period is fine.</summary>
    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (Shown.LeaveWarning(LinkTo(context.TargetLocation)?.Period) is not { } text) return;
        if (!await Modals.ConfirmAsync("Leave without saving?", text, "Leave", danger: true)) context.PreventNavigation();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Shown.Sheet is null) return;
        _cascade = false;
        if (_keys is not null) await _keys.PageRenderedAsync();
        if (Shown.SaveMotion.TakeFlyTicks()) await Animations.FlyTicksAsync();
    }

    private async Task AddRowFromKeyboardAsync()
    {
        if (_panel is not null && await _panel.AddRowAsync() is { } row) _keys?.Focus($"issue-{row.Id}");
    }
}
