@page "/"
@page "/period/{StartText}"
@inject TimeLog Log
@inject PeriodLoader Loader
@inject IssueStatuses Statuses
@inject TimeProvider Clock
@inject WorklogSync Sync
@inject WorkCalendarService Calendar
@inject CurrentUser User
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MotionScript Animations
@implements IAsyncDisposable

@* Loads a period into a PeriodSheet and wires its parts to the services. The rules live in
   PeriodSheet; the markup in Components/Sheet. *@

<PageTitle>Timesheet · Jira Time</PageTitle>

<NavigationLock ConfirmExternalNavigation="@HasUnsaved" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

@if (_sheet is { } sheet)
{
<div class="mx-auto max-w-7xl space-y-6 overflow-x-clip">
    <PeriodHeader Sheet="sheet" Unsynced="_unsynced" Syncing="_syncing" Saving="_savingAll"
                  OnSync="SyncPeriodAsync" OnFillPeriod="FillPeriod" OnSaveAll="SaveAllAsync" OnDiscardAll="DiscardAll" />

    <PeriodReminders Sheet="sheet" Unsynced="_unsynced" Previous="_previousOpen" />

    @if (_jiraError is not null)
    {
        <div class="card flex flex-wrap items-center gap-3 border-amber-300 p-4 text-sm text-amber-800 dark:border-amber-700 dark:text-amber-300" role="alert" data-jira-error>
            <span class="flex-1">Couldn't read your time from Jira: @_jiraError. Only work waiting to be sent is shown, and days can't be edited until Jira can be read.</span>
            <button type="button" class="btn-secondary" disabled="@_loading" @onclick="RetryJiraAsync">@(_loading ? "Trying…" : "Try again")</button>
        </div>
    }

    @* A new period slides in from the side it comes from. *@
    <div @key="sheet.Period" class="space-y-6 @Motion.Slide(_slide)">
        <DayList Sheet="sheet" Selected="_selectedDay" OnSelect="d => SelectDay(d)" />

        <PeriodGrid Sheet="sheet" Selected="_selectedDay" JiraBaseUrl="@User.Connection?.BaseUrl"
                    Cascade="_cascade" JustSaved="_justSaved" SentToJira="_sentToJira"
                    OnSelectDay="d => SelectDay(d, focus: true)" OnCellClicked="CellClicked" />
    </div>

    @* Selected day *@
    <section class="card p-6">
        <DayHeader Date="_selectedDay" Info="sheet.Day(_selectedDay)" Logged="TimeEntry.Total(DayEntries)" Missing="sheet.Missing(_selectedDay)"
                   OnMarkOff="MarkDayOffAsync" OnUnmarkOff="UnmarkDayOffAsync" />

        @if (_notice is not null)
        {
            <div class="mt-3 text-sm text-amber-700 dark:text-amber-400" role="status">@_notice</div>
        }
        @if (User.Connection is { } connection && sheet.HoursKnown)
        {
            <div class="mt-4">
                <DayEditor @ref="_editor" Date="_selectedDay" Saved="DayEntries" Work="sheet.WorkFor(_selectedDay)"
                           Recent="_recent" Comments="_comments" Sprint="sheet.Sprint" Earlier="_earlier" Statuses="Statuses.Known"
                           OnIssuePicked="key => Statuses.LookUpAsync([key])" Connection="connection" Expected="@(sheet.Day(_selectedDay)?.Expected ?? TimeSpan.Zero)"
                           Previous="sheet.PreviousWorkedDay(_selectedDay)"
                           OnChanged="StateHasChanged" OnSaved="DaySavedAsync" OnChangedInJira="ReloadAsync" OnDiscard="() => sheet.Finish(_selectedDay)" />
            </div>
            <p class="hint mt-4 hidden sm:block" data-shortcuts>
                Keys: <kbd>←</kbd> <kbd>→</kbd> previous / next day · <kbd>N</kbd> add a row ·
                <kbd>Enter</kbd> next row · <kbd>Esc</kbd> leave a field · <kbd>Ctrl</kbd>+<kbd>S</kbd> save the day
            </p>
        }
    </section>
</div>
}
else
{
    <p class="mx-auto max-w-7xl text-sm text-slate-500 dark:text-slate-400" role="status" data-loading>Reading your time from Jira…</p>
}

@code {
    [Parameter] public string? StartText { get; set; }
    /// <summary>The selected day, kept in the URL so reload and back/forward keep it.</summary>
    [SupplyParameterFromQuery(Name = "day")] public string? DayText { get; set; }

    /// <summary>Read on each use, so a tab left open overnight moves on to the new day.</summary>
    private DateOnly Today => Clock.Today();

    /// <summary>The period shown, with its unsaved changes; null until the first period has loaded.</summary>
    private PeriodSheet? _sheet;
    private DateOnly _selectedDay;
    private int _unsynced;
    private OpenPeriod? _previousOpen;
    private bool _syncing, _savingAll, _loading;
    /// <summary>News about the selected day, such as days Save all couldn't save.</summary>
    private string? _notice;
    /// <summary>Why Jira couldn't be read; the period then shows only work waiting for Jira and can't be edited.</summary>
    private string? _jiraError;
    private DayEditor? _editor;

    // What the issue picker offers besides the sprint.
    private IReadOnlyList<JiraIssue> _recent = [];
    private IReadOnlyDictionary<string, IReadOnlyList<string>> _comments = new Dictionary<string, IReadOnlyList<string>>();
    /// <summary>Issues assigned to the user that were to do earlier in this period (maybe Done now).</summary>
    private IReadOnlyList<IssueWithStatus> _earlier = [];

    /// <summary>Which way the last period change went: 1 to a later period, -1 to an earlier one, 0 on first show.</summary>
    private int _slide;

    private PeriodSheet Sheet => _sheet!;
    private IReadOnlyList<TimeEntry> DayEntries => Sheet.SavedOn(_selectedDay);
    private bool HasUnsaved => _sheet?.OwnChangeDays.Count > 0;

    protected override async Task OnParametersSetAsync()
    {
        var day = Format.ParseIso(DayText);
        var period = Period.For(Format.ParseIso(StartText) ?? day ?? Today);
        var selected = day is { } d && period.Contains(d) ? d : period.Contains(Today) ? Today : period.Start;

        // Same period, other day (a day picked in the grid, Today, back/forward): keep everything.
        if (_sheet?.Period == period)
        {
            ShowDay(selected);
            return;
        }

        // The old period stays on screen until the new one has loaded.
        var sheet = new PeriodSheet(period, () => Today);
        _slide = _sheet is null ? 0 : period.Start.CompareTo(_sheet.Period.Start);
        await ReloadAsync(sheet);
        (_sheet, _selectedDay, _notice) = (sheet, selected, null);
        sheet.Suggest(_selectedDay);
    }

    // ---- Loading ----

    private Task ReloadAsync() => ReloadAsync(Sheet);

    private async Task ReloadAsync(PeriodSheet sheet)
    {
        _loading = true;
        var loaded = await Loader.LoadAsync(sheet, Statuses);
        _loading = false;
        (_jiraError, _previousOpen, _recent, _comments, _earlier) = (loaded.JiraError, loaded.Previous, loaded.Recent, loaded.Comments, loaded.Earlier);
        _unsynced = sheet.Entries.Count(e => !e.IsSynced);
    }

    private async Task RetryJiraAsync()
    {
        Log.Refresh();
        await ReloadAsync();
        Sheet.Suggest(_selectedDay);
    }

    // ---- Saving and syncing ----

    // The last save, for its animation: days saved, and those Jira got completely.
    private readonly HashSet<DateOnly> _justSaved = [], _sentToJira = [];
    private bool _flyTicks;

    private void Saved(DateOnly day, WorklogSync.DayResult result)
    {
        Sheet.Finish(day);
        _justSaved.Add(day);
        if (result.SyncFailures == 0) _sentToJira.Add(day);
    }

    /// <summary>After the saved work has reloaded, so the ticks start from the saved cells.</summary>
    private void FinishSave() => _flyTicks = _sentToJira.Count > 0;

    private void StartSave()
    {
        _justSaved.Clear();
        _sentToJira.Clear();
    }

    private async Task DaySavedAsync(WorklogSync.DayResult result)
    {
        StartSave();
        Saved(_selectedDay, result);
        await ReloadAsync();
        FinishSave();
    }

    /// <summary>True for the render right after Fill period, so its suggestions drop in day by day.</summary>
    private bool _cascade;

    private void FillPeriod()
    {
        Sheet.FillPeriod();
        _cascade = true;
    }

    private void DiscardAll()
    {
        Sheet.DiscardAll();
        _notice = null;
    }

    /// <summary>Saves every day with unsaved changes. Days that couldn't be saved are left for the user to finish.</summary>
    private async Task SaveAllAsync()
    {
        if (User.Connection is not { } c) return;
        _savingAll = true;
        _notice = null;
        StartSave();
        var result = await Sync.SaveDaysAsync(c, Sheet);
        foreach (var (savedDay, dayResult) in result.Saved) Saved(savedDay, dayResult);
        _savingAll = false;
        if (_justSaved.Contains(_selectedDay)) await Animations.CollapseAsync(MotionScript.RemovedRows);
        await ReloadAsync();
        FinishSave();
        if (result.FirstToFix is { } day)
        {
            SelectDay(day);
            _notice = result.Notice;
        }
    }

    private async Task SyncPeriodAsync()
    {
        if (User.Connection is not { } c) return;
        _syncing = true;
        await Sync.SyncRangeAsync(c, Sheet.Period.Start, Sheet.Period.End);
        Log.Refresh(); // Sync now also picks up what was logged in Jira meanwhile
        await ReloadAsync();
        _syncing = false;
    }

    // ---- Time off ----

    /// <summary>
    /// Marks the selected day, or part of it, off. A suggestion made for the old hours no longer fits and
    /// is made again; changes the user made are kept.
    /// </summary>
    private async Task MarkDayOffAsync(DayHeader.TimeOff off)
    {
        var day = _selectedDay;
        var onlySuggested = Sheet.HasOnlySuggestions(day);
        if (off.Hours is null || onlySuggested) Sheet.Finish(day);
        await Calendar.MarkDayOffAsync(day, off.Reason, off.Hours);
        await ReloadAsync();
        if (off.Hours is not null && onlySuggested) Sheet.Restart(day);
    }

    private async Task UnmarkDayOffAsync()
    {
        await Calendar.UnmarkDayOffAsync(_selectedDay);
        await ReloadAsync();
        Sheet.Restart(_selectedDay);
    }

    // ---- Days and navigation ----

    /// <summary>Selects a day by putting it in the URL; <see cref="OnParametersSetAsync"/> shows it.</summary>
    /// <param name="focus">Focus the day's first hours field once shown (picked with the mouse).</param>
    private void SelectDay(DateOnly day, bool focus = false)
    {
        if (focus) _focus = FirstHours;
        if (day == _selectedDay) return;
        Nav.NavigateTo(Links.To(day), replace: true);
    }

    private void ShowDay(DateOnly day)
    {
        if (day == _selectedDay) return;
        _selectedDay = day;
        _notice = null;
        Sheet.Suggest(day);
    }

    /// <summary>A grid cell: open the day on that issue's row, adding an empty row for it when the day has none.</summary>
    private void CellClicked((DateOnly Day, PeriodRow Row) cell)
    {
        var (day, row) = cell;
        if (row.Key == "")
        {
            SelectDay(day, focus: true);
            return;
        }
        _focus = $"hours-{Sheet.RowFor(day, row.Key, row.Summary).Id}";
        SelectDay(day);
    }

    /// <summary>Asks before leaving the period (or the page) with unsaved changes. Picking another day of the period is fine.</summary>
    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (!HasUnsaved) return;
        var target = Nav.ToBaseRelativePath(Nav.ToAbsoluteUri(context.TargetLocation).ToString());
        if (Links.Read(target, Today)?.Period == Sheet.Period) return;

        if (!await JS.InvokeAsync<bool>("confirm", $"You have unsaved changes on {Format.Days(Sheet.OwnChangeDays.Count)}. Leave without saving them?"))
            context.PreventNavigation();
    }

    // ---- Focus and keyboard shortcuts ----

    private const string FirstHours = "";
    /// <summary>Element id to focus after the next render; <see cref="FirstHours"/> for the day's first hours field.</summary>
    private string? _focus;
    private DotNetObjectReference<Timesheet>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_sheet is null) return;
        _cascade = false;
        if (_self is null)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("jiraKeys.attach", _self);
        }
        if (_focus is { } id)
        {
            _focus = null;
            await JS.InvokeVoidAsync("jiraKeys.focus", id);
        }
        await CelebrateAsync();
        if (_flyTicks)
        {
            _flyTicks = false;
            await Animations.FlyTicksAsync();
        }
    }

    /// <summary>Notices the period becoming complete while it is shown (not one that already was).</summary>
    private Milestones<Period> _completed = new();
    private PeriodSheet? _completedSheet;

    /// <summary>Confetti when the period becomes complete; the script makes sure each period celebrates once per browser.</summary>
    private async Task CelebrateAsync()
    {
        if (_sheet is not { } sheet || User.Key is not { } user) return;
        if (_completedSheet != sheet) (_completedSheet, _completed) = (sheet, new());
        var complete = sheet.Summary.IsComplete(_unsynced, sheet.UnsavedDays.Count > 0);
        if (_completed.Update(complete ? [sheet.Period] : []).Count > 0)
            await Animations.CelebrateAsync(user, sheet.Period);
    }

    [JSInvokable]
    public async Task SaveDayFromKeyboard()
    {
        if (_editor is null) return;
        await InvokeAsync(async () =>
        {
            await _editor.SaveAsync();
            StateHasChanged(); // shows the editor's errors when the day wasn't saved
        });
    }

    [JSInvokable]
    public Task MoveDay(int delta) => InvokeAsync(() => SelectDay(_selectedDay.AddDays(delta)));

    [JSInvokable]
    public async Task AddRowFromKeyboard()
    {
        if (_editor is null) return;
        await InvokeAsync(async () =>
        {
            var row = await _editor.AddRowAsync();
            _focus = $"issue-{row.Id}";
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_self is null) return;
        try
        {
            await JS.InvokeVoidAsync("jiraKeys.detach");
        }
        catch (JSDisconnectedException)
        {
            // The tab is gone; nothing to detach.
        }
        _self.Dispose();
    }
}
