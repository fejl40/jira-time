@page "/"
@page "/period/{StartText}"
@using System.Globalization
@inject TimeEntryService Entries
@inject TimeProvider Clock
@inject WorklogSync Sync
@inject WorkCalendarService Calendar
@inject JiraIssueLookup Issues
@inject CurrentUser User
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Loads a period into a PeriodSheet and wires its parts to the services. The rules live in
   PeriodSheet; the markup in Components/Sheet. *@

<PageTitle>Timesheet · Jira Time</PageTitle>

<NavigationLock ConfirmExternalNavigation="@HasUnsaved" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

@if (_sheet is { } sheet)
{
<div class="mx-auto max-w-7xl space-y-6">
    <PeriodHeader Sheet="sheet" Unsynced="_unsynced" Syncing="_syncing" Saving="_savingAll"
                  OnSync="SyncPeriodAsync" OnFillPeriod="FillPeriod" OnSaveAll="SaveAllAsync" OnDiscardAll="DiscardAll" />

    <PeriodReminders Sheet="sheet" Unsynced="_unsynced" Previous="_previousOpen" />

    @if (_importing)
    {
        <p class="-mt-3 text-xs text-slate-500 dark:text-slate-400" role="status">Checking Jira for worklogs…</p>
    }
    else if (_importNotice is not null)
    {
        <p class="-mt-3 text-xs text-slate-500 dark:text-slate-400" role="status" data-import-notice>@_importNotice</p>
    }

    <DayList Sheet="sheet" Selected="_selectedDay" OnSelect="d => SelectDay(d)" />

    <PeriodGrid Sheet="sheet" Selected="_selectedDay" JiraBaseUrl="@User.Connection?.BaseUrl" Cascade="_cascade" JustSaved="_justSaved" SentToJira="_sentToJira"
                OnSelectDay="d => SelectDay(d, focus: true)" OnCellClicked="CellClicked" />

    @* Selected day *@
    <section class="card p-6">
        <DayHeader Date="_selectedDay" Info="sheet.Day(_selectedDay)" Logged="PeriodSheet.Total(DayEntries)" Missing="sheet.Missing(_selectedDay)"
                   OnMarkOff="MarkDayOffAsync" OnUnmarkOff="UnmarkDayOffAsync" />

        @if (_notice is not null)
        {
            <div class="mt-3 text-sm text-amber-700 dark:text-amber-400" role="status">@_notice</div>
        }
        @if (User.Connection is { } connection)
        {
            <div class="mt-4">
                <DayEditor @ref="_editor" Date="_selectedDay" Saved="DayEntries" Work="sheet.WorkFor(_selectedDay)"
                           Recent="_recent" Comments="_comments" Sprint="sheet.Sprint" Earlier="_earlier" Statuses="_statuses"
                           OnIssuePicked="LookUpStatusAsync" Connection="connection" Expected="@(sheet.Day(_selectedDay)?.Expected ?? TimeSpan.Zero)"
                           Previous="sheet.PreviousWorkedDay(_selectedDay)"
                           OnChanged="StateHasChanged" OnSaved="DaySavedAsync" OnDiscard="() => sheet.Finish(_selectedDay)" />
            </div>
            <p class="hint mt-4 hidden sm:block" data-shortcuts>
                Keys: <kbd>←</kbd> <kbd>→</kbd> previous / next day · <kbd>N</kbd> add a row ·
                <kbd>Enter</kbd> next row · <kbd>Esc</kbd> leave a field · <kbd>Ctrl</kbd>+<kbd>S</kbd> save the day
            </p>
        }
    </section>
</div>
}

@code {
    [Parameter] public string? StartText { get; set; }
    /// <summary>The selected day, kept in the URL so reload and back/forward keep it.</summary>
    [SupplyParameterFromQuery(Name = "day")] public string? DayText { get; set; }

    /// <summary>Read on each use, so a tab left open overnight moves on to the new day.</summary>
    private DateOnly Today => Clock.Today();

    /// <summary>The period shown, with its unsaved changes; null until the first period has loaded.</summary>
    private PeriodSheet? _sheet;
    private DateOnly _selectedDay;
    private int _unsynced;
    private PeriodReminders.OpenPeriod? _previousOpen;
    private bool _syncing, _savingAll, _importing;
    /// <summary>News about the selected day, such as days Save all couldn't save.</summary>
    private string? _notice;
    private string? _importNotice;
    private DayEditor? _editor;

    // What the issue picker offers besides the sprint.
    private IReadOnlyList<JiraIssue> _recent = [];
    private IReadOnlyDictionary<string, IReadOnlyList<string>> _comments = new Dictionary<string, IReadOnlyList<string>>();
    /// <summary>Issues assigned to the user that were to do earlier in this period (maybe Done now).</summary>
    private IReadOnlyList<IssueWithStatus> _earlier = [];
    /// <summary>Current Jira status per issue key, for the "isn't to do" note.</summary>
    private readonly Dictionary<string, IssueWithStatus> _statuses = new(StringComparer.OrdinalIgnoreCase);

    private PeriodSheet Sheet => _sheet!;
    private IReadOnlyList<TimeEntry> DayEntries => Sheet.SavedOn(_selectedDay);
    private bool HasUnsaved => _sheet?.OwnChangeDays.Count > 0;

    protected override async Task OnParametersSetAsync()
    {
        var day = ParseDate(DayText);
        var period = Period.For(ParseDate(StartText) ?? day ?? Today);
        var selected = day is { } d && period.Contains(d) ? d : period.Contains(Today) ? Today : period.Start;

        // Same period, other day (a day picked in the grid, Today, back/forward): keep everything.
        if (_sheet?.Period == period)
        {
            ShowDay(selected);
            return;
        }

        // The old period stays on screen until the new one has loaded.
        var sheet = new PeriodSheet(period, () => Today);
        await ReloadAsync(sheet);
        (_sheet, _selectedDay, _notice) = (sheet, selected, null);
        await ImportAsync(); // renders the local hours first, then adds what Jira has
        sheet.Suggest(_selectedDay);
    }

    private static DateOnly? ParseDate(string? text) =>
        DateOnly.TryParseExact(text, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d : null;

    // ---- Loading ----

    private Task ReloadAsync() => ReloadAsync(Sheet);

    private async Task ReloadAsync(PeriodSheet sheet)
    {
        var p = sheet.Period;
        sheet.Load(
            await Entries.GetRangeAsync(p.Start, p.End),
            await Entries.GetRangeAsync(p.Start.AddDays(-DayFiller.LookBackDays), p.Start.AddDays(-1)),
            await Calendar.GetDaysAsync(p.Start, p.End));
        _recent = await Entries.GetRecentIssuesAsync();
        _comments = await Entries.GetRecentCommentsAsync();
        _unsynced = (await Entries.GetUnsyncedAsync(p.Start, p.End)).Count;
        _previousOpen = await LoadPreviousAsync(p);
        await LoadIssuesAsync(sheet);
    }

    /// <summary>The period before the current one, when it has missing hours or work not in Jira.</summary>
    private async Task<PeriodReminders.OpenPeriod?> LoadPreviousAsync(Period period)
    {
        if (!period.Contains(Today)) return null;
        var prev = period.Previous;
        var summary = PeriodSummary.For(prev, await Calendar.GetDaysAsync(prev.Start, prev.End), await Entries.GetRangeAsync(prev.Start, prev.End), Today);
        var notInJira = (await Entries.GetUnsyncedAsync(prev.Start, prev.End)).Count;
        return summary.Missing > TimeSpan.Zero || notInJira > 0 ? new(prev, summary.Missing, notInJira) : null;
    }

    /// <summary>Brings in worklogs logged in Jira for the period. Jira being down only shows a notice.</summary>
    private async Task ImportAsync()
    {
        _importNotice = null;
        if (User is not { Connection: { } c, Profile: { } profile } || User.VerifiedOffline) return;
        _importing = true;
        StateHasChanged();
        var sheet = Sheet;
        try
        {
            var result = await Sync.ImportAsync(c, profile, sheet.Period.Start, sheet.Period.End);
            if (sheet != _sheet) return; // moved on to another period meanwhile
            if (result.Changes > 0)
            {
                await ReloadAsync();
                _importNotice = ImportSummary(result);
            }
        }
        catch (JiraException ex)
        {
            _importNotice = $"Couldn't read your worklogs from Jira: {ex.Message}";
        }
        finally
        {
            _importing = false;
        }
    }

    private static string ImportSummary(WorklogSync.ImportResult r) =>
        "From Jira: " + string.Join(", ", new[]
        {
            r.Added > 0 ? $"{r.Added} new {(r.Added == 1 ? "worklog" : "worklogs")}" : null,
            r.Updated > 0 ? $"{r.Updated} changed" : null,
            r.Removed > 0 ? $"{r.Removed} deleted" : null,
        }.Where(x => x is not null)) + ".";

    /// <summary>
    /// Sprint issues for picks and suggestions, issues from earlier in the period, and the current status
    /// of every issue logged in the period. Jira being down just means fewer picks.
    /// </summary>
    private async Task LoadIssuesAsync(PeriodSheet sheet)
    {
        if (User is not { Connection: { } c, Profile: { } profile }) return;
        sheet.Sprint = await OrEmptyAsync(() => Issues.GetSprintAsync(c, profile));
        _earlier = await OrEmptyAsync(() => Issues.GetPeriodAsync(c, profile, sheet.Period));
        foreach (var i in sheet.Sprint.Concat(_earlier)) _statuses[i.Key] = i;
        await LookUpStatusesAsync(sheet.Entries.Select(e => e.IssueKey));
    }

    private static async Task<IReadOnlyList<IssueWithStatus>> OrEmptyAsync(Func<Task<IReadOnlyList<IssueWithStatus>>> load)
    {
        try
        {
            return await load();
        }
        catch (JiraException)
        {
            return [];
        }
    }

    private Task LookUpStatusAsync(string key) => LookUpStatusesAsync([key]);

    private async Task LookUpStatusesAsync(IEnumerable<string> keys)
    {
        if (User.Connection is not { } c) return;
        var unknown = keys.Where(k => k != "" && !_statuses.ContainsKey(k)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        if (unknown.Count == 0) return;
        try
        {
            foreach (var (key, issue) in await Issues.GetStatusesAsync(c, unknown)) _statuses[key] = issue;
        }
        catch (JiraException)
        {
            // No status means no note; the time can still be logged.
        }
    }

    // ---- Saving and syncing ----

    // The last save, for its animation: days saved, and those Jira got completely.
    private readonly HashSet<DateOnly> _justSaved = [], _sentToJira = [];
    private bool _flyTicks;

    private void Saved(DateOnly day, WorklogSync.DayResult result)
    {
        Sheet.Finish(day);
        _justSaved.Add(day);
        if (result.SyncFailures == 0) _sentToJira.Add(day);
    }

    /// <summary>After the saved work has reloaded, so the ticks start from the saved cells.</summary>
    private void FinishSave() => _flyTicks = _sentToJira.Count > 0;

    private void StartSave()
    {
        _justSaved.Clear();
        _sentToJira.Clear();
    }

    private async Task DaySavedAsync(WorklogSync.DayResult result)
    {
        StartSave();
        Saved(_selectedDay, result);
        await ReloadAsync();
        FinishSave();
    }

    /// <summary>True for the render right after Fill period, so its suggestions drop in day by day.</summary>
    private bool _cascade;

    private void FillPeriod()
    {
        Sheet.FillPeriod();
        _cascade = true;
    }

    private void DiscardAll()
    {
        Sheet.DiscardAll();
        _notice = null;
    }

    /// <summary>Saves every day with unsaved changes. Days with an invalid row are left for the user to finish.</summary>
    private async Task SaveAllAsync()
    {
        if (User.Connection is not { } c) return;
        _savingAll = true;
        _notice = null;
        var needsWork = new List<DateOnly>();
        StartSave();
        foreach (var day in Sheet.UnsavedDays)
        {
            var work = Sheet.WorkFor(day);
            var result = work.BadHours.Count == 0 ? await Sync.SaveDayAsync(c, day, work.RowsToSave(Sheet.SavedOn(day))) : null;
            if (result is { Saved: true }) Saved(day, result);
            else needsWork.Add(day);
        }
        _savingAll = false;
        await ReloadAsync();
        FinishSave();
        if (needsWork.Count > 0)
        {
            SelectDay(needsWork[0]);
            _notice = $"{Format.Days(needsWork.Count)} not saved because a row needs an issue or hours. Finish it below and press Save day.";
        }
    }

    private async Task SyncPeriodAsync()
    {
        if (User.Connection is not { } c) return;
        _syncing = true;
        await Sync.SyncRangeAsync(c, Sheet.Period.Start, Sheet.Period.End);
        await ImportAsync();
        _syncing = false;
        await ReloadAsync();
    }

    // ---- Time off ----

    /// <summary>
    /// Marks the selected day, or part of it, off. A suggestion made for the old hours no longer fits and
    /// is made again; changes the user made are kept.
    /// </summary>
    private async Task MarkDayOffAsync(DayHeader.TimeOff off)
    {
        var day = _selectedDay;
        var onlySuggested = Sheet.HasOnlySuggestions(day);
        if (off.Hours is null || onlySuggested) Sheet.Finish(day);
        await Calendar.MarkDayOffAsync(day, off.Reason, off.Hours);
        await ReloadAsync();
        if (off.Hours is not null && onlySuggested) Sheet.Restart(day);
    }

    private async Task UnmarkDayOffAsync()
    {
        await Calendar.UnmarkDayOffAsync(_selectedDay);
        await ReloadAsync();
        Sheet.Restart(_selectedDay);
    }

    // ---- Days and navigation ----

    /// <summary>Selects a day by putting it in the URL; <see cref="OnParametersSetAsync"/> shows it.</summary>
    /// <param name="focus">Focus the day's first hours field once shown (picked with the mouse).</param>
    private void SelectDay(DateOnly day, bool focus = false)
    {
        if (focus) _focus = FirstHours;
        if (day == _selectedDay) return;
        Nav.NavigateTo(Links.To(day), replace: true);
    }

    private void ShowDay(DateOnly day)
    {
        if (day == _selectedDay) return;
        _selectedDay = day;
        _notice = null;
        Sheet.Suggest(day);
    }

    /// <summary>A grid cell: open the day on that issue's row, adding an empty row for it when the day has none.</summary>
    private void CellClicked((DateOnly Day, PeriodRow Row) cell)
    {
        var (day, row) = cell;
        if (row.Key == "")
        {
            SelectDay(day, focus: true);
            return;
        }
        _focus = $"hours-{Sheet.RowFor(day, row.Key, row.Summary).Id}";
        SelectDay(day);
    }

    /// <summary>Asks before leaving the period (or the page) with unsaved changes. Picking another day of the period is fine.</summary>
    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (!HasUnsaved) return;
        var target = Nav.ToBaseRelativePath(Nav.ToAbsoluteUri(context.TargetLocation).ToString());
        var path = target.Split('?', '#')[0].TrimEnd('/');
        var query = target.Contains('?') ? target[(target.IndexOf('?') + 1)..] : "";
        var day = ParseDate(System.Web.HttpUtility.ParseQueryString(query)["day"]);
        Period? to = path == "" ? Period.For(day ?? Today)
            : path.StartsWith("period/") && ParseDate(path["period/".Length..]) is { } start ? Period.For(start)
            : null;
        if (to == Sheet.Period) return;

        if (!await JS.InvokeAsync<bool>("confirm", $"You have unsaved changes on {Format.Days(Sheet.OwnChangeDays.Count)}. Leave without saving them?"))
            context.PreventNavigation();
    }

    // ---- Focus and keyboard shortcuts ----

    private const string FirstHours = "";
    /// <summary>Element id to focus after the next render; <see cref="FirstHours"/> for the day's first hours field.</summary>
    private string? _focus;
    private DotNetObjectReference<Timesheet>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_sheet is null) return;
        _cascade = false;
        if (_self is null)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("jiraKeys.attach", _self);
        }
        if (_focus is { } id)
        {
            _focus = null;
            await JS.InvokeVoidAsync("jiraKeys.focus", id);
        }
        if (_flyTicks)
        {
            _flyTicks = false;
            await JS.InvokeVoidAsync("jiraMotion.flyTicks", "[data-sent]", "[data-period-status]");
        }
    }

    [JSInvokable]
    public async Task SaveDayFromKeyboard()
    {
        if (_editor is null) return;
        await InvokeAsync(async () =>
        {
            await _editor.SaveAsync();
            StateHasChanged(); // shows the editor's errors when the day wasn't saved
        });
    }

    [JSInvokable]
    public Task MoveDay(int delta) => InvokeAsync(() => SelectDay(_selectedDay.AddDays(delta)));

    [JSInvokable]
    public async Task AddRowFromKeyboard()
    {
        if (_editor is null) return;
        await InvokeAsync(async () =>
        {
            var row = await _editor.AddRowAsync();
            _focus = $"issue-{row.Id}";
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_self is null) return;
        try
        {
            await JS.InvokeVoidAsync("jiraKeys.detach");
        }
        catch (JSDisconnectedException)
        {
            // The tab is gone; nothing to detach.
        }
        _self.Dispose();
    }
}
