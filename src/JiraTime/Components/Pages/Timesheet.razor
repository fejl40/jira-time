@page "/"
@page "/period/{StartText}"
@using System.Globalization
@inject TimeEntryService Entries
@inject ConnectionState Conn
@inject WorklogSync Sync
@inject WorkCalendarService Calendar
@inject SprintIssues Sprint
@inject SettingsService Settings
@inject NavigationManager Nav

<PageTitle>Timesheet · Jira Time</PageTitle>

@if (_loaded)
{
<div class="mx-auto max-w-7xl space-y-6">
    @* Period header *@
    <div class="flex flex-wrap items-center gap-3">
        <div>
            <h1 class="text-xl font-semibold">Timesheet</h1>
            <p class="text-sm text-slate-500 dark:text-slate-400">@Format.Range(_period.Start, _period.End)</p>
        </div>
        <div class="ml-auto flex items-center gap-2">
            @if (_unsynced > 0)
            {
                <span class="text-sm text-amber-700 dark:text-amber-400">@_unsynced not in Jira</span>
                <button class="btn-secondary mr-3" disabled="@_syncing" @onclick="SyncPeriodAsync">@(_syncing ? "Syncing…" : "Sync now")</button>
            }
            <span class="mr-3 text-sm text-slate-500 dark:text-slate-400">Period total <span class="ml-1 text-base font-semibold text-slate-800 dark:text-slate-100">@(Format.Hours(Total(_entries)) is { Length: > 0 } t ? t : "0") h</span></span>
            @if (PeriodMissing > TimeSpan.Zero)
            {
                <span class="mr-3 text-sm text-amber-700 dark:text-amber-400" title="Hours missing on workdays up to today">@Format.Hours(PeriodMissing) h missing</span>
            }
            @if (_proposals.Count > 0)
            {
                <span class="text-sm text-blue-700 dark:text-blue-300">@Format.Hours(DraftTotal(_proposals.Values.SelectMany(l => l))) h suggested on @(_proposals.Count == 1 ? "1 day" : $"{_proposals.Count} days")</span>
                <button class="btn-secondary" disabled="@_accepting" @onclick="DiscardAll">Discard all</button>
                <button class="btn-primary mr-3" disabled="@_accepting" @onclick="() => AcceptAsync(_proposals.Keys)">@(_accepting ? "Saving…" : "Accept all")</button>
            }
            else if (PeriodMissing > TimeSpan.Zero)
            {
                <button class="btn-secondary mr-3" title="Suggest entries for every workday so far that is short of 8 hours" @onclick="FillPeriodAsync">Fill period</button>
            }
            <a class="btn-secondary px-3" href="@Link(_period.Previous)" title="Previous period">‹</a>
            <a class="btn-secondary" href="">Today</a>
            <a class="btn-secondary px-3" href="@Link(_period.Next)" title="Next period">›</a>
        </div>
    </div>

    @* Period grid: issues × days *@
    <div class="overflow-x-auto rounded-xl bg-white dark:bg-slate-900 shadow-sm ring-1 ring-slate-200 dark:ring-slate-700">
        <table class="w-full border-collapse text-sm">
            <thead>
                <tr class="border-b border-slate-200 dark:border-slate-700 text-xs text-slate-500 dark:text-slate-400">
                    <th class="sticky left-0 z-10 min-w-64 bg-white dark:bg-slate-900 px-4 py-2 text-left font-medium">Issue</th>
                    @foreach (var (day, i) in _period.Days.Select((d, i) => (d, i)))
                    {
                        <th class="@DayCellClass(day, i) min-w-12 p-0 font-medium" title="@DayTitle(day)">
                            <button type="button" class="w-full px-1 py-2" @onclick="() => SelectDay(day)">
                                <div class="uppercase">@day.ToString("ddd", CultureInfo.InvariantCulture)[..2]</div>
                                <div class="text-sm @(day == _today ? "mx-auto grid size-6 place-items-center rounded-full bg-blue-600 font-semibold text-white" : "text-slate-700 dark:text-slate-200")">@day.Day</div>
                            </button>
                        </th>
                    }
                    <th class="min-w-16 px-3 py-2 text-right font-medium">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Rows)
                {
                    <tr class="border-b border-slate-100 dark:border-slate-800 last:border-0 hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
                        <td class="sticky left-0 z-10 max-w-80 bg-white dark:bg-slate-900 px-4 py-2">
                            <div class="flex items-center gap-2">
                                <span class="size-2.5 flex-none rounded-full @IssueColors.For(row.Key)"></span>
                                @if (row.Key == "")
                                {
                                    <span class="italic text-slate-500 dark:text-slate-400">No issue guessed yet</span>
                                }
                                else
                                {
                                    <a href="@($"{Conn.Connection?.BaseUrl}/browse/{row.Key}")" target="_blank" rel="noopener"
                                       class="font-semibold text-blue-700 dark:text-blue-400 hover:underline">@row.Key</a>
                                }
                                <span class="truncate text-slate-600 dark:text-slate-300" title="@row.Summary">@row.Summary</span>
                            </div>
                        </td>
                        @foreach (var (day, i) in _period.Days.Select((d, i) => (d, i)))
                        {
                            <td class="@DayCellClass(day, i) cursor-pointer p-2 text-center tabular-nums" @onclick="() => SelectDay(day)">
                                @Format.Hours(Total(row.Entries.Where(e => e.Date == day)))
                                @if (DraftTotal(row.Drafts.Where(d => d.Date == day)) is { } draft && draft > TimeSpan.Zero)
                                {
                                    <span class="ml-0.5 inline-block rounded border border-dashed border-blue-400 px-1 text-xs text-blue-700 dark:border-blue-600 dark:text-blue-300" title="Suggested, not saved" data-draft-cell>@Format.Hours(draft)</span>
                                }
                            </td>
                        }
                        <td class="px-3 py-2 text-right font-medium tabular-nums">@Format.Hours(Total(row.Entries))</td>
                    </tr>
                }
                @if (Rows.Count == 0)
                {
                    <tr>
                        <td colspan="@(_period.Length + 2)" class="px-4 py-10 text-center text-slate-500 dark:text-slate-400">No time logged in this period yet. Pick a day below and add an entry.</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="border-t border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 text-xs font-semibold">
                    <td class="sticky left-0 z-10 bg-slate-50 dark:bg-slate-800 px-4 py-2 text-slate-500 dark:text-slate-400">Day total</td>
                    @foreach (var (day, i) in _period.Days.Select((d, i) => (d, i)))
                    {
                        <td class="@DayCellClass(day, i, footer: true) p-2 text-center tabular-nums">@Format.Hours(Total(_entries.Where(e => e.Date == day)))</td>
                    }
                    <td class="px-3 py-2 text-right tabular-nums">@Format.Hours(Total(_entries))</td>
                </tr>
                @if (_proposals.Count > 0)
                {
                    <tr class="bg-slate-50 dark:bg-slate-800/60 text-xs font-semibold text-blue-700 dark:text-blue-300">
                        <td class="sticky left-0 z-10 bg-slate-50 dark:bg-slate-800 px-4 py-2">Suggested</td>
                        @foreach (var (day, i) in _period.Days.Select((d, i) => (d, i)))
                        {
                            <td class="@DayCellClass(day, i, footer: true) p-2 text-center tabular-nums">@Format.Hours(DraftTotal(_proposals.GetValueOrDefault(day) ?? []))</td>
                        }
                        <td class="px-3 py-2 text-right tabular-nums">@Format.Hours(DraftTotal(_proposals.Values.SelectMany(l => l)))</td>
                    </tr>
                }
                @if (PeriodMissing > TimeSpan.Zero)
                {
                    <tr class="bg-slate-50 dark:bg-slate-800/60 text-xs font-semibold text-amber-700 dark:text-amber-400">
                        <td class="sticky left-0 z-10 bg-slate-50 dark:bg-slate-800 px-4 py-2">Missing</td>
                        @foreach (var (day, i) in _period.Days.Select((d, i) => (d, i)))
                        {
                            <td class="@DayCellClass(day, i, footer: true) p-2 text-center tabular-nums">@(Missing(day) is { } m && m > TimeSpan.Zero ? Format.Hours(m) : "")</td>
                        }
                        <td class="px-3 py-2 text-right tabular-nums">@Format.Hours(PeriodMissing)</td>
                    </tr>
                }
            </tfoot>
        </table>
    </div>

    @* Selected day *@
    <section class="card p-6">
        <div class="flex flex-wrap items-center gap-3">
            <h2 class="text-lg font-semibold">@_selectedDay.ToString("dddd d MMMM", CultureInfo.InvariantCulture)</h2>
            <span class="text-sm text-slate-500 dark:text-slate-400">@(Format.Hours(Total(DayEntries)) is { Length: > 0 } h ? $"{h} h" : "Nothing logged")</span>
            @if (SelectedDay is { Kind: DayKind.Holiday or DayKind.Weekend } info)
            {
                <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 text-xs text-slate-600 dark:text-slate-300">@(info.Name ?? "Weekend")</span>
            }
            else if (SelectedDay is { Kind: DayKind.DayOff } off)
            {
                <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 text-xs text-slate-600 dark:text-slate-300">Day off · @off.Name</span>
                <button class="btn-ghost text-xs" @onclick="UnmarkDayOffAsync">Undo</button>
            }
            else if (SelectedDay is { Kind: DayKind.Workday })
            {
                @if (Missing(_selectedDay) is { } miss && miss > TimeSpan.Zero && _selectedDay <= _today)
                {
                    <span class="text-sm text-amber-700 dark:text-amber-400">@Format.Hours(miss) h missing</span>
                }
                <select class="field w-auto py-1 text-xs" aria-label="Mark day off" value="" @onchange="MarkDayOffAsync">
                    <option value="">Mark day off…</option>
                    @foreach (var r in Enum.GetValues<DayOffReason>())
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            }
            @if (_draft is null)
            {
                <div class="ml-auto flex gap-2">
                    @if (CanFill(_selectedDay) && !_proposals.ContainsKey(_selectedDay))
                    {
                        <button class="btn-secondary" title="Suggest entries for the missing hours" @onclick="FillDayAsync">Fill day</button>
                    }
                    <button class="btn-primary" @onclick="NewEntry">+ Add entry</button>
                </div>
            }
        </div>


        @if (_proposals.TryGetValue(_selectedDay, out var proposals))
        {
            <div class="mt-5">
                <DraftList Drafts="proposals" Choices="Choices" Errors="_proposalErrors" Busy="_accepting"
                           OnAccept="() => AcceptAsync([_selectedDay])" OnDiscard="() => Discard(_selectedDay)" OnChanged="ProposalsChanged" />
            </div>
        }

        @if (_draft is not null && Conn.Connection is { } connection)
        {
            <div class="mt-5">
                <EntryEditor Entry="_draft" IsNew="_draftIsNew" Connection="connection" Recent="_recent" Sprint="_sprint" OnDone="EditorDoneAsync" />
            </div>
        }

        <ul class="mt-5 divide-y divide-slate-100 dark:divide-slate-800">
            @foreach (var e in DayEntries)
            {
                <li class="flex items-start gap-4 py-3 @(e.Id == _draft?.Id ? "opacity-40" : "")">
                    <span class="mt-1.5 size-2.5 flex-none rounded-full @IssueColors.For(e.IssueKey)"></span>
                    <div class="min-w-0 flex-1">
                        <div class="text-sm"><span class="font-semibold">@e.IssueKey</span> <span class="text-slate-600 dark:text-slate-300">@e.IssueSummary</span></div>
                        @if (e.Description is not null)
                        {
                            <div class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">@e.Description</div>
                        }
                        @if (!e.IsSynced && e.SyncError is not null)
                        {
                            <div class="mt-0.5 text-xs text-amber-700 dark:text-amber-400">Jira: @e.SyncError</div>
                        }
                    </div>
                    <div class="w-12 text-right text-sm font-medium tabular-nums">@Format.Hours(e.Duration)</div>
                    <div class="w-28 text-right text-xs">
                        @if (e.IsSynced)
                        {
                            <span class="text-emerald-700 dark:text-emerald-400" title="Logged in Jira">✓ In Jira</span>
                        }
                        else
                        {
                            <button class="font-medium text-amber-700 hover:underline dark:text-amber-400" title="@(e.SyncError ?? "Not sent to Jira yet")"
                                    disabled="@_syncing" @onclick="() => RetryAsync(e)">Not in Jira · Retry</button>
                        }
                    </div>
                    <button class="btn-ghost text-xs" @onclick="() => Edit(e)">Edit</button>
                </li>
            }
        </ul>
    </section>
</div>

}

@code {
    [Parameter] public string? StartText { get; set; }

    private static readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);

    private Period _period;
    private IReadOnlyList<TimeEntry> _entries = [];
    private IReadOnlyList<JiraIssue> _recent = [];
    private IReadOnlyList<SprintIssue> _sprint = [];
    private DateOnly _selectedDay;
    private TimeEntry? _draft;
    private bool _draftIsNew, _loaded, _syncing;
    private int _unsynced;

    private record IssueRow(string Key, string Summary, List<TimeEntry> Entries, List<TimeEntry> Drafts);

    /// <summary>One row per issue with saved or suggested time in the period.</summary>
    private List<IssueRow> Rows =>
        _entries.Select(e => (Entry: e, Draft: false))
            .Concat(_proposals.Values.SelectMany(l => l).Select(d => (Entry: d, Draft: true)))
            .GroupBy(x => x.Entry.IssueKey)
            .Select(g => new IssueRow(g.Key,
                g.OrderBy(x => x.Draft).ThenByDescending(x => x.Entry.UpdatedUtc).First().Entry.IssueSummary,
                g.Where(x => !x.Draft).Select(x => x.Entry).ToList(),
                g.Where(x => x.Draft).Select(x => x.Entry).ToList()))
            .OrderBy(r => r.Key == "").ThenBy(r => r.Key, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IReadOnlyDictionary<DateOnly, DayInfo> _days = new Dictionary<DateOnly, DayInfo>();

    /// <summary>Suggested entries per day, not saved yet.</summary>
    private readonly Dictionary<DateOnly, List<TimeEntry>> _proposals = [];
    private Dictionary<string, string> _proposalErrors = [];
    private bool _accepting;

    private IReadOnlyList<TimeEntry> DayEntries => _entries.Where(e => e.Date == _selectedDay).ToList();
    private DayInfo? SelectedDay => _days.GetValueOrDefault(_selectedDay);

    /// <summary>Missing hours on a day; only counted up to today.</summary>
    private TimeSpan Missing(DateOnly day) =>
        day > _today || !_days.TryGetValue(day, out var info)
            ? TimeSpan.Zero
            : WorkCalendarService.Missing(info, Total(_entries.Where(e => e.Date == day)));

    private TimeSpan PeriodMissing => _period.Days.Aggregate(TimeSpan.Zero, (t, d) => t + Missing(d));

    private string? DayTitle(DateOnly day) => _days.GetValueOrDefault(day) switch
    {
        { Kind: DayKind.Holiday, Name: var n } => n,
        { Kind: DayKind.DayOff, Name: var n } => $"Day off ({n})",
        _ => null,
    };

    protected override async Task OnParametersSetAsync()
    {
        var date = DateOnly.TryParseExact(StartText, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d : _today;
        _period = Period.For(date);
        _selectedDay = _period.Contains(_today) ? _today : _period.Start;
        _draft = null;
        _proposals.Clear();
        _proposalErrors.Clear();
        await ReloadAsync();
        _loaded = true;
    }

    private async Task ReloadAsync()
    {
        _entries = await Entries.GetRangeAsync(_period.Start, _period.End);
        _recent = await Entries.GetRecentIssuesAsync();
        _unsynced = (await Entries.GetUnsyncedAsync(_period.Start, _period.End)).Count;
        _days = await Calendar.GetDaysAsync(_period.Start, _period.End);
        await LoadSprintAsync();
    }

    /// <summary>Active-sprint issues for quick picks and suggestions. Jira being down just means no picks.</summary>
    private async Task LoadSprintAsync()
    {
        if (Conn.Connection is not { } c || (await Settings.GetAsync()).Profile is not { } profile) return;
        try
        {
            _sprint = await Sprint.GetAsync(c, profile);
        }
        catch (JiraException)
        {
            _sprint = [];
        }
    }

    /// <summary>Issues offered for suggestions: sprint first, then recent.</summary>
    private IReadOnlyList<JiraIssue> Choices =>
        _sprint.Select(i => i.ToIssue()).Concat(_recent).DistinctBy(i => i.Key).ToList();

    /// <summary>Only workdays up to today with hours missing can be filled.</summary>
    private bool CanFill(DateOnly day) => day <= _today && Missing(day) > TimeSpan.Zero;

    private async Task FillDayAsync()
    {
        if (_days.GetValueOrDefault(_selectedDay) is not { } info) return;
        var drafts = DayFiller.Propose(info, DayEntries, _sprint);
        if (drafts.Count > 0) _proposals[_selectedDay] = drafts.ToList();
    }

    private async Task FillPeriodAsync()
    {
        foreach (var (day, drafts) in DayFiller.ProposePeriod(_days.Values, _today, _entries, _sprint))
            _proposals[day] = drafts.ToList();
    }

    private void DiscardAll()
    {
        _proposals.Clear();
        _proposalErrors.Clear();
    }

    private static TimeSpan DraftTotal(IEnumerable<TimeEntry> drafts) =>
        drafts.Aggregate(TimeSpan.Zero, (t, d) => t + d.Duration);

    private void ProposalsChanged()
    {
        foreach (var (day, list) in _proposals.Where(p => p.Value.Count == 0).ToList()) _proposals.Remove(day);
    }

    private void Discard(DateOnly day)
    {
        if (_proposals.Remove(day, out var list))
            foreach (var d in list) _proposalErrors.Remove(d.Id);
    }

    /// <summary>Saves the suggestions for <paramref name="days"/> (each then syncs to Jira). Ones that fail validation stay as drafts with the reason.</summary>
    private async Task AcceptAsync(IEnumerable<DateOnly> days)
    {
        if (Conn.Connection is not { } c) return;
        _accepting = true;
        foreach (var day in days.ToList())
        {
            if (!_proposals.TryGetValue(day, out var list)) continue;
            foreach (var d in list.ToList())
            {
                var result = await Sync.SaveAsync(c, d);
                if (result.Saved)
                {
                    list.Remove(d);
                    _proposalErrors.Remove(d.Id);
                }
                else _proposalErrors[d.Id] = result.ValidationError!;
            }
            if (list.Count == 0) _proposals.Remove(day);
        }
        _accepting = false;
        await ReloadAsync();
    }

    private async Task MarkDayOffAsync(ChangeEventArgs e)
    {
        if (!Enum.TryParse<DayOffReason>(e.Value?.ToString(), out var reason)) return;
        Discard(_selectedDay);
        await Calendar.MarkDayOffAsync(_selectedDay, reason);
        await ReloadAsync();
    }

    private async Task UnmarkDayOffAsync()
    {
        await Calendar.UnmarkDayOffAsync(_selectedDay);
        await ReloadAsync();
    }

    private async Task RetryAsync(TimeEntry e)
    {
        if (Conn.Connection is not { } c) return;
        _syncing = true;
        await Sync.SyncAsync(c, e);
        _syncing = false;
        await ReloadAsync();
    }

    private async Task SyncPeriodAsync()
    {
        if (Conn.Connection is not { } c) return;
        _syncing = true;
        await Sync.SyncRangeAsync(c, _period.Start, _period.End);
        _syncing = false;
        await ReloadAsync();
    }

    private void SelectDay(DateOnly day)
    {
        _selectedDay = day;
        _draft = null;
    }

    private void NewEntry()
    {
        // Default to what the day is still missing, so one entry can finish it.
        var missing = Missing(_selectedDay);
        _draft = new TimeEntry { IssueKey = "", Date = _selectedDay, Duration = missing > TimeSpan.Zero ? missing : TimeSpan.Zero };
        _draftIsNew = true;
    }

    private void Edit(TimeEntry e)
    {
        _draft = e;
        _draftIsNew = false;
    }

    private async Task EditorDoneAsync()
    {
        var saved = _draft;
        _draft = null;
        await ReloadAsync();
        // Follow the entry if its date was moved to another day in this period.
        if (saved is not null && _entries.FirstOrDefault(e => e.Id == saved.Id) is { } moved && moved.Date != _selectedDay)
            _selectedDay = moved.Date;
    }

    private static TimeSpan Total(IEnumerable<TimeEntry> entries) => entries.Aggregate(TimeSpan.Zero, (t, e) => t + e.Duration);

    private static string Link(Period p) => $"period/{Format.Iso(p.Start)}";

    private string DayCellClass(DateOnly day, int index, bool footer = false)
    {
        var classes = new List<string>();
        if (index > 0 && day.DayOfWeek == DayOfWeek.Monday) classes.Add("border-l-2 border-slate-300 dark:border-slate-600"); // week boundary
        if (day == _selectedDay) classes.Add("bg-blue-50 dark:bg-blue-950/60");
        else if (!footer && _days.GetValueOrDefault(day) is { IsWorkday: false }) classes.Add("bg-slate-50 dark:bg-slate-800/60");
        if (!footer && _days.GetValueOrDefault(day) is { Kind: DayKind.Holiday or DayKind.DayOff }) classes.Add("text-slate-400 dark:text-slate-500");
        return string.Join(' ', classes);
    }
}
