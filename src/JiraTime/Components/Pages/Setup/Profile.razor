@page "/setup/profile"
@inject JiraClient Jira
@inject ConnectionState Conn
@inject SettingsService Settings
@inject NavigationManager Nav

<PageTitle>Profile · Jira Time</PageTitle>

@if (_connection is not null)
{
    <div class="card mx-auto max-w-lg">
        <div class="step">Step 2 of 2</div>
        <h1 class="text-xl font-semibold">Find your Jira profile</h1>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Your hours will be logged and listed for this user.</p>

        <label class="field-label" for="user-search">Search users</label>
        <Autocomplete TItem="JiraProfile" Id="user-search" Placeholder="Name, username or email"
                      Search="(q, ct) => Jira.SearchUsersAsync(_connection, q, ct)"
                      TextOf="u => u.DisplayName" OnSelected="u => _selected = u">
            <ItemTemplate>
                <UserRow User="context" />
            </ItemTemplate>
        </Autocomplete>

        @if (_selected is not null)
        {
            <div class="mt-4 rounded-lg p-3 ring-1 ring-blue-600">
                <UserRow User="_selected" Tag="Selected" />
            </div>
        }

        @if (_myself is not null && _myself.Id != _selected?.Id)
        {
            <p class="mt-5 text-center text-xs text-slate-500 dark:text-slate-400">or use the account this token belongs to</p>
            <button type="button" class="mt-2 w-full rounded-lg p-3 text-left ring-1 ring-slate-200 dark:ring-slate-700 hover:bg-blue-50 dark:hover:bg-blue-950/60 hover:ring-blue-600"
                    @onclick="() => _selected = _myself">
                <UserRow User="_myself" Tag="Use this" />
            </button>
        }

        @if (_error is not null)
        {
            <div class="alert-error" role="alert">@_error</div>
        }

        <div class="mt-7 flex justify-end gap-2">
            <a href="setup/connect" class="btn-secondary">Back</a>
            <button class="btn-primary" disabled="@(_selected is null)" @onclick="SaveAsync">Continue</button>
        </div>
    </div>
}

@code {
    private JiraConnection? _connection;
    private JiraProfile? _selected, _myself;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _connection = await Conn.LoadAsync();
        if (_connection is null)
        {
            Nav.NavigateTo("setup/connect");
            return;
        }

        _selected = (await Settings.GetAsync()).Profile;
        try
        {
            _myself = await Jira.GetMyselfAsync(_connection);
        }
        catch (JiraException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SaveAsync()
    {
        if (_selected is null) return;
        await Settings.SaveProfileAsync(_selected);
        Nav.NavigateTo("");
    }
}
