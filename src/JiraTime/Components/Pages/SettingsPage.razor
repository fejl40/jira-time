@page "/settings"
@inject CurrentUser User
@inject SignInSession Session
@inject TimeProvider Clock
@inject NavigationManager Nav
@inject WorkCalendarService Calendar

<PageTitle>Settings · Jira Time</PageTitle>

<div class="mx-auto max-w-2xl space-y-6">
    <h1 class="text-xl font-semibold">Settings</h1>

    <section class="card p-6">
        <h2 class="font-semibold">Jira connection</h2>
        @if (User.Connection is { } c)
        {
            <dl class="mt-3 grid grid-cols-[8rem_1fr] gap-y-1 text-sm">
                <dt class="text-muted">URL</dt><dd>@c.BaseUrl</dd>
                <dt class="text-muted">Type</dt><dd>@(c.IsCloud ? "Cloud (API token)" : "Server / Data Center (PAT)")</dd>
                @if (c.Email is not null)
                {
                    <dt class="text-muted">Email</dt><dd>@c.Email</dd>
                }
            </dl>
        }
        <p class="hint mt-3">The token is encrypted with a key that only this server has, then kept in this browser's local storage.</p>
        <div class="mt-4 flex gap-2">
            <a href="setup/connect" class="btn-secondary">Change connection</a>
            <button class="btn-danger" @onclick="DisconnectAsync">Disconnect</button>
        </div>
    </section>

    <section class="card p-6">
        <h2 class="font-semibold">Profile</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">The Jira user your token belongs to. Change the connection to log hours as someone else.</p>
        @if (User.Profile is { } p)
        {
            <div class="mt-3"><UserRow User="p" /></div>
        }
    </section>

    <section class="card p-6" data-work-hours>
        <h2 class="font-semibold">Work hours</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Hours each weekday needs. Danish public holidays and time you mark off are left out. A day with 0 hours is not a workday.</p>
        <div class="mt-4 grid grid-cols-4 gap-3 sm:grid-cols-7">
            @foreach (var day in Week)
            {
                <label class="text-xs text-muted">
                    @day.ToString()[..3]
                    <input type="text" inputmode="decimal" class="field mt-1 py-1.5 text-right text-sm" aria-label="@day hours"
                           value="@_hours.GetValueOrDefault(day)" @onchange="e => SetHours(day, e)" />
                </label>
            }
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-2">
            <span class="text-sm text-slate-600 dark:text-slate-300">@(WeekTotal is { } t ? $"{Format.Hours(t)} h a week" : "")</span>
            @if (_hoursMessage is not null)
            {
                <span class="text-sm @(_hoursSaved ? "text-emerald-700 dark:text-emerald-400" : "text-red-700 dark:text-red-400")" role="status">@_hoursMessage</span>
            }
            <button class="btn-ghost ml-auto" @onclick="StandardWeek">8 h Monday to Friday</button>
            <button class="btn-primary" @onclick="SaveHoursAsync">Save hours</button>
        </div>
    </section>

    <section class="card p-6">
        <h2 class="font-semibold">Timesheet periods</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Periods run from the 1st to the 15th and from the 16th to the end of the month.</p>
        <p class="hint mt-2">Current period: @{ var cur = Period.For(Clock.Today()); } @Format.Range(cur.Start, cur.End)</p>
    </section>
</div>

@code {
    private static readonly DayOfWeek[] Week =
        [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];

    private Dictionary<DayOfWeek, string> _hours = [];
    private string? _hoursMessage;
    private bool _hoursSaved;

    protected override async Task OnInitializedAsync()
    {
        if (!User.IsSignedIn) return;
        Show((await Calendar.GetSettingsAsync()).WorkHours);
    }

    private void Show(IReadOnlyDictionary<DayOfWeek, TimeSpan> hours) =>
        _hours = Week.ToDictionary(d => d, d => hours.GetValueOrDefault(d) is var h && h > TimeSpan.Zero ? Format.Hours(h) : "0");

    private static TimeSpan? Read(string text) => text.Trim() is "" or "0" ? TimeSpan.Zero : TypedHours.Parse(text);

    private TimeSpan? WeekTotal => _hours.Values.Select(Read).Aggregate((TimeSpan?)TimeSpan.Zero, (t, h) => t + h);

    private void SetHours(DayOfWeek day, ChangeEventArgs e)
    {
        _hours[day] = e.Value?.ToString() ?? "";
        _hoursMessage = null;
    }

    private void StandardWeek()
    {
        Show(UserSettings.StandardWeek());
        _hoursMessage = null;
    }

    private async Task SaveHoursAsync()
    {
        var parsed = new Dictionary<DayOfWeek, TimeSpan>();
        foreach (var day in Week)
        {
            if (Read(_hours[day]) is not { } h)
            {
                (_hoursMessage, _hoursSaved) = ($"{day}: enter hours like 7.5 or 7:30.", false);
                return;
            }
            parsed[day] = h;
        }
        var error = await Calendar.SaveWorkHoursAsync(parsed);
        (_hoursMessage, _hoursSaved) = (error ?? "Saved.", error is null);
        if (error is null) Show(parsed);
    }

    private async Task DisconnectAsync()
    {
        await Session.SignOutAsync();
        Nav.NavigateTo("setup/connect");
    }
}
